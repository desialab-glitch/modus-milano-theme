{{ 'section-tabs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tabs.js' | asset_url }}" defer="defer"></script>

{%- style -%}
	{% render 'section-margin' %}
	{% render 'section-padding' %}
	/* This section's title-item gap is intentionally reset to 0 (guards
	   against the base theme's own flex-gap doubling with the heading's
	   own margin-bottom, if any). The accompanying "margin-bottom: .8rem"
	   that used to sit here (attempting a tighter eyebrow->heading gap than
	   the sitewide default) never actually took effect: modus-design-system
	   .css's ".section-header__title-item .section-header__title { margin:
	   0 0 var(--modus-space-xs) !important }" always wins over a
	   non-!important declaration regardless of specificity or wrapper, so
	   this section's title->description gap has always matched every other
	   section's (var(--modus-space-xs), currently 1.2rem) — removed the
	   inert line (2026-09-07) rather than leave code that implies
	   otherwise. */
	#shopify-section-{{ section.id }} .section-header__title-item {
		gap: 0;
	}
	/* Tab subheading color (2026-09-07): family/style/size/line-height/
	   letter-spacing/transform used to be re-declared here too, but this
	   element also carries the sitewide ".subtitle" class, whose !important
	   rule in modus-design-system.css already forces all of those (Lora
	   italic, 15px/26px, no letter-spacing, no transform) -- this local,
	   non-!important attempt at a different size (14px/1.6 line-height)
	   never actually rendered. Kept only the color, which nothing else
	   overrides for this specific element. */
	#shopify-section-{{ section.id }} .tab__item-info-subtitle {
		color: rgba(61, 61, 61, 0.6);
	}
	/* Breathing room between the progress line and the subheading text.
	   Reads the shared eyebrow/heading/description/CTA rhythm token. */
	#shopify-section-{{ section.id }} .tab-thumb_item-pagination {
		margin-bottom: var(--modus-space-xs);
	}
	/* Tab paragraph text: the block markup uses inline_richtext, so it never
	   wraps in a <p> — the sitewide "*__desc* p" paragraph-size rules in
	   modus-paragraph-global.css only match a <p> descendant, so they never
	   apply here and this div was left on the raw .medium-font class, which
	   computes to ~0.9rem on mobile — far smaller than the theme's single
	   canonical body-paragraph size. Force it to match that canonical size
	   directly, the same way the slideshow section's .medium-font override
	   does it. */
	#shopify-section-{{ section.id }} .tab__item-info-desc,
	#shopify-section-{{ section.id }} .tab__item-info-desc.medium-font {
		font-family: var(--font-body-family) !important;
		font-style: var(--font-body-style) !important;
		font-weight: var(--font-body-weight) !important;
		font-size: var(--modus-paragraph-size) !important;
		line-height: 1.6 !important;
	}
	/* Description -> CTA gap: this div's own box has never had a margin
	   (the sitewide "*__desc* p" rule above only matches a <p> descendant,
	   and this uses inline_richtext with no wrapping <p>), so the button
	   right below it sat with no breathing room at all. Matches the
	   sitewide eyebrow/heading/paragraph -> CTA rhythm used elsewhere in
	   the theme (e.g. the grid-banner section). */
	#shopify-section-{{ section.id }} .tab__item-info-desc {
		margin-bottom: var(--modus-space-xs);
	}
	/* Same gap, single source (2026-09-24): the base theme's own
	   section-tabs.css also carries ".tab__item-info-desc+.button
	   {margin-top:16px}" (a leftover from before the formula above was
	   added). Both rules target different sides of the same gap and
	   neither collapses against the other -- the button here is
	   display:inline-flex (buttons never collapse margins with an
	   adjacent block, inline-flex or not), so they stack: 1.2rem +
	   1.6rem = ~2.8rem, well past the intended 1.2rem rhythm, and on
	   every device equally (this isn't a mobile-only bug). Same fix
	   pattern as modus-fix-produttore-gap.css: zero out the older,
	   less specific rule so only the size above still applies. */
	#shopify-section-{{ section.id }} .tab__item-info-desc + .button {
		margin-top: 0;
	}
	/* On stacked mobile headers, the theme removes the title block's bottom
	   padding. Restore the shared 12px rhythm from description to CTA. */
	@media screen and (max-width: 989px) {
		#shopify-section-{{ section.id }} .section-header__btn-top {
			margin-top: var(--modus-space-xs) !important;
		}
	}
{%- endstyle -%}

<div
	class="tabs color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding"
	data-id="shopify-section-{{ section.id }}"
	data-autoplay="{{ section.settings.is_autoplay }}"
	data-speed="{{ section.settings.slider_speed }}"
	data-delay="{{ section.settings.slider_delay }}"
	data-effect="{{ section.settings.slide_effects }}"
	data-per-row="{{ section.blocks.size }}"
>
	{%- style -%}
		#shopify-section-{{ section.id }} {
			--delay: {{ section.settings.slider_delay }}s;
			--speed: {{ section.settings.slider_speed }}s;
		}
	{%- endstyle -%}

	{% render 'section-header' %}
	<div class="container">
		{% if section.settings.blocks_type == 'type1' %}
			<div class="tabs_wrapper-type1">
				<div class="tabs_box swiper">
					<div class="swiper-wrapper">
						{%- for block in section.blocks -%}
							<div class="swiper-slide">
								<div class="tab__item-img">
									{% if block.settings.video != blank %}
										{% liquid
											assign video_height = block.settings.video.sources[0].width | divided_by: block.settings.video.aspect_ratio
										%}
										{{
											block.settings.video
											| video_tag:
												width: block.settings.video.sources[0].width,
												height: video_height,
												autoplay: true,
												loop: true,
												controls: false,
												muted: true
										}}
									{% elsif block.settings.image != blank %}
										{% assign image_height = block.settings.image.width
											| divided_by: block.settings.image.aspect_ratio
										%}
										{{
											block.settings.image
											| image_url: width: 3840
											| image_tag:
												loading: 'lazy',
												sizes: '100vw',
												widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
												height: image_height
										}}
									{% else %}
										{% assign image_index = forloop.index0
											| modulo: 6
											| plus: 1
										%}
										{{
											'collection-'
											| append: image_index
											| placeholder_svg_tag: ' placeholder'
										}}
									{% endif %}
								</div>
							</div>
						{%- endfor -%}
					</div>
					<div class="tabs-thumb_wrapper swiper">
						<div class="swiper-wrapper">
							{%- for block in section.blocks -%}
								<div class="swiper-slide">
									<div class="tab-thumb_item-wrapper">
										<div
											class="tab-thumb_item-pagination{% if section.settings.is_autoplay %} tab-thumb_item-pagination-animation{% endif %}"
										></div>
										{%- if block.settings.subheading != blank -%}
											<div class="tab__item-info-subtitle subtitle">
												{{ block.settings.subheading }}
											</div>
										{%- endif -%}
										<h3 class="tab__item-info-title">
											{% if block.settings.heading != blank %}
												{{ block.settings.heading }}
											{% endif %}
										</h3>

										<div class="tab__item-info-block">
											{% if block.settings.description != blank %}
												<div class="tab__item-info-desc medium-font">
													{{ block.settings.description }}
												</div>
											{% endif %}
											{% render 'button', layout: block %}
										</div>
									</div>
								</div>
							{%- endfor -%}
						</div>
					</div>
				</div>
			</div>
		{% elsif section.settings.blocks_type == 'type2' %}
			<div class="tabs_wrapper-type2">
				<div class="tab_item-wrapper">
					<div class="tabs_box swiper">
						<div class="swiper-wrapper">
							{%- for block in section.blocks -%}
								<div class="swiper-slide">
									<div class="tab__item-img">
										{% if block.settings.video != blank %}
											{% liquid
												assign video_height = block.settings.video.sources[0].width | divided_by: block.settings.video.aspect_ratio
											%}
											{{
												block.settings.video
												| video_tag:
													width: block.settings.video.sources[0].width,
													height: video_height,
													autoplay: true,
													loop: true,
													controls: false,
													muted: true
											}}
										{% elsif block.settings.image != blank %}
											{% assign image_height = block.settings.image.width
												| divided_by: block.settings.image.aspect_ratio
											%}
											{{
												block.settings.image
												| image_url: width: 3840
												| image_tag:
													loading: 'lazy',
													sizes: '100vw',
													widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
													height: image_height
											}}
										{% else %}
											{% assign image_index = forloop.index0
												| modulo: 6
												| plus: 1
											%}
											{{
												'collection-'
												| append: image_index
												| placeholder_svg_tag: ' placeholder'
											}}
										{% endif %}
									</div>
								</div>
							{%- endfor -%}
						</div>
					</div>
					<div class="tabs_box-content swiper">
						<div class="swiper-wrapper">
							{%- for block in section.blocks -%}
								<div class="swiper-slide">
									<div class="tab__item-info-block">
										{%- if block.settings.subheading != blank -%}
											<div class="tab__item-info-subtitle subtitle">
												{{ block.settings.subheading }}
											</div>
										{%- endif -%}
										{% if block.settings.description != blank %}
											<div class="tab__item-info-desc medium-font">
												{{ block.settings.description }}
											</div>
										{% endif %}
										{% render 'button', layout: block %}
									</div>
								</div>
							{%- endfor -%}
						</div>
					</div>
					<div class="tabs-thumb_wrapper swiper">
						<div class="swiper-wrapper">
							{%- for block in section.blocks -%}
								<div class="swiper-slide">
									<div class="tab-thumb_item-wrapper">
										<div
											class="tab-thumb_item-pagination{% if section.settings.is_autoplay %} tab-thumb_item-pagination-animation{% endif %}"
										></div>
										{% if block.settings.heading != blank %}
											<h3 class="tab__item-info-title">
												{{ block.settings.heading }}
											</h3>
										{% endif %}
									</div>
								</div>
							{%- endfor -%}
						</div>
					</div>
				</div>
			</div>
		{% else %}
			<div class="tabs_wrapper-type3">
				<div class="tab_item-wrapper">
					<div class="tabs_box swiper">
						<div class="swiper-wrapper">
							{%- for block in section.blocks -%}
								<div class="swiper-slide">
									<div class="tab__item-img">
										{% if block.settings.video != blank %}
											{% liquid
												assign video_height = block.settings.video.sources[0].width | divided_by: block.settings.video.aspect_ratio
											%}
											{{
												block.settings.video
												| video_tag:
													width: block.settings.video.sources[0].width,
													height: video_height,
													autoplay: true,
													loop: true,
													controls: false,
													muted: true
											}}
										{% elsif block.settings.image != blank %}
											{% assign image_height = block.settings.image.width
												| divided_by: block.settings.image.aspect_ratio
											%}
											{{
												block.settings.image
												| image_url: width: 3840
												| image_tag:
													loading: 'lazy',
													sizes: '100vw',
													widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
													height: image_height
											}}
										{% else %}
											{% assign image_index = forloop.index0
												| modulo: 6
												| plus: 1
											%}
											{{
												'collection-'
												| append: image_index
												| placeholder_svg_tag: ' placeholder'
											}}
										{% endif %}
									</div>
								</div>
							{%- endfor -%}
						</div>
					</div>
					<div class="tabs_box-content swiper">
						<div class="swiper-wrapper">
							{%- for block in section.blocks -%}
								<div class="swiper-slide">
									<div class="tab__item-info-block">
										{%- if block.settings.subheading != blank -%}
											<div class="tab__item-info-subtitle subtitle">
												{{ block.settings.subheading }}
											</div>
										{%- endif -%}
										{% if block.settings.heading != blank %}
											<h3 class="tab__item-info-title">
												{{ block.settings.heading }}
											</h3>
										{% endif %}
										{% if block.settings.description != blank %}
											<div class="tab__item-info-desc medium-font">
												{{ block.settings.description }}
											</div>
										{% endif %}
										{% render 'button', layout: block %}
									</div>
								</div>
							{%- endfor -%}
						</div>
					</div>
					<div class="tabs-thumb_wrapper swiper">
						<div class="swiper-wrapper">
							{%- for block in section.blocks -%}
								<div class="swiper-slide">
									<div class="tab-thumb_item-wrapper">
										{% if block.settings.video != blank %}
											{% liquid
												assign video_height = block.settings.video.sources[0].width | divided_by: block.settings.video.aspect_ratio
											%}
											{{
												block.settings.video
												| video_tag:
													width: block.settings.video.sources[0].width,
													height: video_height,
													autoplay: true,
													loop: true,
													controls: false,
													muted: true
											}}
										{% elsif block.settings.image != blank %}
											{% assign image_height = block.settings.image.width
												| divided_by: block.settings.image.aspect_ratio
											%}
											{{
												block.settings.image
												| image_url: width: 3840
												| image_tag:
													loading: 'lazy',
													sizes: '100vw',
													widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
													height: image_height
											}}
										{% else %}
											{% assign image_index = forloop.index0
												| modulo: 6
												| plus: 1
											%}
											{{
												'collection-'
												| append: image_index
												| placeholder_svg_tag: ' placeholder'
											}}
										{% endif %}
									</div>
								</div>
							{%- endfor -%}
						</div>
					</div>
				</div>

			</div>
		{% endif %}
		{% if section.settings.section_header_type == 'type1'
			and section.settings.button_label != blank
		%}
			<div class="section-header_btn">
				{% render 'button', layout: section %}
			</div>
		{% endif %}
	</div>
</div>

{% schema %}
{
	"name": "t:sections.tabs.name",
	"tag": "section",
	"class": "tabs-section",
	"enabled_on": {
		"templates": ["*"],
		"groups": ["footer"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"default": "background-1",
			"label": "t:sections.all.color_scheme.label"
		},
		{
			"type": "select",
			"id": "section_header_type",
			"label": "t:sections.all.section_header.header.content",
			"default": "type2",
			"options": [
				{
					"value": "type1",
					"label": "t:sections.all.section_header.options.options__1.label"
				},
				{
					"value": "type2",
					"label": "t:sections.all.section_header.options.options__2.label"
				}
			]
		},
		{
			"type": "checkbox",
			"id": "enable_border_top",
			"default": true,
			"label": "t:sections.all.section_header.border"
		},
		{
			"type": "text",
			"id": "subheading",
			"default": "t:sections.tabs.settings.subheading.default",
			"label": "t:sections.all.subheading.label"
		},
		{
			"type": "inline_richtext",
			"id": "heading",
			"default": "t:sections.tabs.settings.heading.default",
			"label": "t:sections.all.heading.label"
		},
		{
			"type": "select",
			"id": "heading_tag",
			"label": "t:sections.all.heading.tag.label",
			"info": "t:sections.all.heading.tag.info",
			"options": [
				{ "value": "h1", "label": "t:sections.all.heading.tag.options.h1.label" },
				{ "value": "h2", "label": "t:sections.all.heading.tag.options.h2.label" },
				{ "value": "h3", "label": "t:sections.all.heading.tag.options.h3.label" },
				{ "value": "h4", "label": "t:sections.all.heading.tag.options.h4.label" },
				{ "value": "h5", "label": "t:sections.all.heading.tag.options.h5.label" },
				{ "value": "h6", "label": "t:sections.all.heading.tag.options.h6.label" },
				{ "value": "div", "label": "t:sections.all.heading.tag.options.div.label" },
				{ "value": "span", "label": "t:sections.all.heading.tag.options.span.label" },
				{ "value": "p", "label": "t:sections.all.heading.tag.options.p.label" }
			],
			"default": "h2"
		},
		{
			"type": "richtext",
			"id": "description",
			"default": "t:sections.tabs.settings.description.default",
			"label": "t:sections.all.description.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.button.header.content"
		},
		{
			"type": "text",
			"id": "button_label",
			"default": "t:sections.tabs.settings.button_label.default",
			"label": "t:sections.all.button.label.label",
			"info": "t:sections.all.button.label.info"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "t:sections.all.button.link.label"
		},
		{
			"type": "select",
			"id": "button_style",
			"options": [
				{
					"value": "primary",
					"label": "t:sections.all.button.style.options__1.label"
				},
				{
					"value": "secondary",
					"label": "t:sections.all.button.style.options__2.label"
				},
				{
					"value": "tertiary",
					"label": "t:sections.all.button.style.options__3.label"
				}
			],
			"default": "primary",
			"label": "t:sections.all.button.style.label"
		},
		{
			"type": "checkbox",
			"id": "button_arrow",
			"default": false,
			"label": "t:sections.all.button.arrow.label"
		},
		{
			"type": "select",
			"id": "blocks_type",
			"label": "t:sections.tabs.settings.blocks_type.label",
			"default": "type1",
			"options": [
				{
					"value": "type1",
					"label": "t:sections.tabs.settings.blocks_type.option_1"
				},
				{
					"value": "type2",
					"label": "t:sections.tabs.settings.blocks_type.option_2"
				},
				{
					"value": "type3",
					"label": "t:sections.tabs.settings.blocks_type.option_3"
				}
			]
		},
		{
			"type": "header",
			"content": "t:sections.all.slider_options.header.content"
		},
		{
			"type": "checkbox",
			"id": "is_autoplay",
			"default": true,
			"label": "t:sections.all.slider_options.slider_is_autoplay.label"
		},
		{
			"type": "range",
			"id": "slider_speed",
			"min": 0,
			"max": 6,
			"step": 0.1,
			"default": 1.1,
			"unit": "s",
			"label": "t:sections.all.slider_options.speed.label"
		},
		{
			"type": "range",
			"id": "slider_delay",
			"min": 0,
			"max": 8,
			"step": 0.1,
			"default": 3,
			"unit": "s",
			"label": "t:sections.all.slider_options.delay.label"
		},
		{
			"type": "select",
			"id": "slide_effects",
			"options": [
				{
					"value": "slide",
					"label": "t:sections.all.slider_options.effects.options.options__1.label"
				},
				{
					"value": "fade",
					"label": "t:sections.all.slider_options.effects.options.options__2.label"
				},
				{
					"value": "coverflow",
					"label": "t:sections.all.slider_options.effects.options.options__3.label"
				}
			],
			"default": "fade",
			"label": "t:sections.all.slider_options.effects.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.section-margin.header.content"
		},
		{
			"type": "select",
			"id": "margin_top",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				}
			],
			"default": "no-indent",
			"label": "t:sections.all.section-margin.margin_top.label"
		},
		{
			"type": "select",
			"id": "margin_bottom",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
