{{ 'section-grid-banner.css' | asset_url | stylesheet_tag }}

{% liquid
	assign cards_grid_max_columns = section.settings.columns | at_most: 4
	assign cards_grid_block_count = section.blocks.size
	assign cards_grid_effective_columns = cards_grid_block_count | at_most: cards_grid_max_columns
	if cards_grid_effective_columns < 1
		assign cards_grid_effective_columns = 1
	endif
	assign mobile_slider = section.settings.mobile_slider
	assign mobile_slider_item_basis = '85%'
	if section.settings.mobile_slider_columns == '2'
		assign mobile_slider_item_basis = 'calc((100% - ' | append: section.settings.mobile_gap | append: 'px) / 2)'
	endif
%}

{%- style -%}
	{% render 'section-margin' %}
	{% render 'section-padding' %}
{%- endstyle -%}

{%- style -%}
	.cards-grid__wrapper {
		grid-template-columns: 1fr;
	}

	@media screen and (min-width: 750px) {
		.cards-grid__wrapper {
			grid-template-columns: repeat(auto-fit, minmax(45%, 1fr));
		}
	}

	@media screen and (max-width: 989px) {
		.cards-grid__item {
			grid-column-start: 1 !important;
			grid-column-end: 2 !important;
			grid-row-start: auto !important;
			grid-row-end: auto !important;
		}
	}

	@media screen and (max-width: 1149px) {
		.cards-grid__item {
			grid-column-start: auto !important;
			grid-column-end: auto !important;
			grid-row-start: auto !important;
			grid-row-end: auto !important;
		}
	}

	@media screen and (min-width: 1150px) {
		#shopify-section-{{ section.id }} .cards-grid__wrapper {
			grid-template-columns: repeat({{ cards_grid_effective_columns }}, 1fr);
		}
		{% if section.settings.auto_layout %}
		#shopify-section-{{ section.id }} .cards-grid__item {
			grid-column: auto !important;
			grid-row: auto !important;
		}
		{% endif %}
	}

	/* Full-width section header text: this section's intro (subheading + heading + description)
	   should span the whole container instead of the theme-wide 650/700px title-item cap. */
	#shopify-section-{{ section.id }} .section-header__title-item {
		max-width: none;
		width: 100%;
	}
	#shopify-section-{{ section.id }} .section-header__title__block {
		width: 100%;
	}

	#shopify-section-{{ section.id }} .cards-grid__heading {
		font-family: var(--font-heading-family);
		font-style: var(--font-heading-style);
		font-weight: 400;
		/* Brand orange (#D16A14), not gold (#c28342, --modus-gold) -- was gold
		   before, corrected everywhere this heading renders since this rule
		   has no media query, so the fix already applies on every device. */
		color: #D16A14;
		/* !important (2026-08-29): this is an <h3>, and the sitewide
		   `h1,h2,h3,...,.h1..h8 { margin-bottom: 1.2rem !important; }` rule in
		   modus-design-system.css targets the bare h3 tag selector, which beats
		   this local reset (no !important) regardless of specificity. Left
		   unguarded, that added an extra 1.2rem margin-bottom on top of this
		   card's own 1.2rem flex `gap`, doubling the heading -> body gap to
		   2.4rem. !important lets this reset actually win, so the flex gap is
		   the only source of spacing here. */
		margin: 0 !important;
	}

	#shopify-section-{{ section.id }} .cards-grid__info-item {
		display: flex;
		flex-direction: column;
		/* Matches the sitewide eyebrow/heading/paragraph rhythm --
		   var(--modus-space-xs), defined in modus-design-system.css. */
		gap: var(--modus-space-xs);
	}
	/* Guaranteed minimum gap before the button row, even when this card is
	   exactly as tall as its tallest sibling and the auto margin below
	   (on .cards-grid__info-item-btns) has no extra space left to push
	   into. See the alignment block below for the full explanation. Only
	   when the card has buttons (cards without buttons used to end with an
	   extra 12px), 2026-09-25. */
	#shopify-section-{{ section.id }} .cards-grid__info-item:not(:last-child) {
		margin-bottom: var(--modus-space-xs);
	}

	/* Equal-height cards + bottom-aligned buttons: cards in the same row can
	   have different amounts of text (e.g. one column's description runs
	   longer than another's), which by default leaves their buttons sitting
	   at different heights. The base .cards-grid__wrapper sets
	   align-items: flex-start (section-grid-banner.css), so each card is only
	   ever as tall as its own content -- overridden here to stretch, so every
	   card in the same row takes the height of the tallest one. With that,
	   .cards-grid__info and .cards-grid__info-block become flex columns that
	   fill that stretched card height, and the button row gets margin-top:
	   auto (see .cards-grid__info-item-btns below) so it's pushed down to the
	   bottom of whichever card has extra room -- lining every card's buttons
	   up on the same row, however much text sits above them, and adjusting
	   smoothly as text length changes rather than needing a fixed offset. */
	#shopify-section-{{ section.id }} .cards-grid__wrapper {
		align-items: stretch;
	}

	#shopify-section-{{ section.id }} .cards-grid__info {
		flex: 1 1 auto;
		display: flex;
		flex-direction: column;
	}

	#shopify-section-{{ section.id }} .cards-grid__info-block {
		flex: 1 1 auto;
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	/* !important (2026-08-29): .subtitle is caught by modus-design-system.css's
	   sitewide `.subtitle, [class*="subheading"], [class*="eyebrow"],
	   [class*="badge"] { margin-bottom: 1.2rem !important; }` fallback default.
	   Without !important here, that sitewide rule always won (same cascade
	   reason as .cards-grid__heading above), stacking its own 1.2rem
	   margin-bottom on top of this container's 1.2rem flex gap and doubling
	   the subtitle -> heading gap in every card to 2.4rem instead of 1.2rem. */
	#shopify-section-{{ section.id }} .cards-grid__info-item .subtitle,
	#shopify-section-{{ section.id }} .cards-grid__info-item .cards-grid__heading,
	#shopify-section-{{ section.id }} .cards-grid__info .cards-grid-text {
		margin: 0 !important;
	}

	#shopify-section-{{ section.id }} .cards-grid__info .cards-grid-text {
		max-width: none;
	}

	#shopify-section-{{ section.id }} .cards-grid__info .cards-grid-text p {
		font-family: var(--font-body-family);
		font-style: var(--font-body-style);
		font-weight: var(--font-body-weight);
		line-height: 1.6;
		margin: 0;
	}

	#shopify-section-{{ section.id }} .cards-grid__info .cards-grid-text p + p {
		margin-top: 1.6rem;
		margin-bottom: 1.6rem;
	}

	/* Subtitle font styling (2026-09-07): removed a local font-size/color
	   re-declaration that lived here (14px / #4d4d4d, no !important) --
	   modus-design-system.css's sitewide `.subtitle {...}` rule already sets
	   this element's type (15px, rgba(61,61,61,0.6)) with !important, which
	   always wins over a non-!important rule regardless of specificity, so
	   this local attempt never actually rendered. Removed as dead code
	   rather than left in place implying a difference that wasn't real. */

	#shopify-section-{{ section.id }} .cards-grid__divider {
		width: 100%;
		height: 1px;
		background-color: currentColor;
		opacity: 0.15;
		margin: 1.5rem 0;
	}

	#shopify-section-{{ section.id }} .cards-grid__secondary-text,
	#shopify-section-{{ section.id }} .cards-grid__secondary-text p {
		font-family: var(--font-body-family);
		font-style: var(--font-body-style);
		font-weight: var(--font-body-weight);
		font-size: 1.3rem; /* 13px floor */
		line-height: 1.6;
		opacity: 0.75;
		margin: 0;
	}

	/* Always show buttons, never hide on desktop */
	#shopify-section-{{ section.id }} .cards-grid__info-item-btns {
		display: flex !important;
		opacity: 1 !important;
		gap: var(--modus-space-xs);
		width: 100%;
		/* margin-top: auto (instead of a fixed value) consumes whatever extra
		   vertical room this card has once stretched to match its tallest
		   sibling (see the alignment block above), pushing the button row
		   down to the bottom of the card so it lines up with every other
		   card's buttons. The 1.2rem sitewide paragraph -> CTA gap is still
		   guaranteed as a minimum via .cards-grid__info-item's margin-bottom
		   above, which applies even when this card has no extra room to push
		   into (i.e. it's already the tallest one in the row). */
		margin-top: auto;
	}

	#shopify-section-{{ section.id }} .cards-grid__info-item-btns .button {
		flex: 1;
		text-align: center;
		justify-content: center;
		border-radius: 0;
		min-height: 48px;
	}
	/* Mobile: two buttons stack, one full-width CTA per line (like every
	   other section's CTAs), instead of sharing the row 50/50. */
	@media screen and (max-width: 749px) {
		#shopify-section-{{ section.id }} .cards-grid__info-item-btns {
			flex-direction: column;
		}
		#shopify-section-{{ section.id }} .cards-grid__info-item-btns .button {
			flex: none;
		}
	}

	/* Mobile: spacing between cards, editable via the "Mobile: spacing between
	   cards" setting (default 10px) — applies to both the stacked grid layout
	   (row/column gap) and the slider layout (per-card right padding, below).
	   !important (2026-08-29): the base .cards-grid__wrapper rule in
	   section-grid-banner.css sets its own gap/row-gap shorthand; guard this
	   ID-scoped override with !important so the editable mobile value always
	   wins regardless of any future change to that base rule's ordering. */
	@media screen and (max-width: 749px) {
		#shopify-section-{{ section.id }} .cards-grid__wrapper {
			gap: {{ section.settings.mobile_gap }}px !important;
			row-gap: {{ section.settings.mobile_gap }}px !important;
		}
	}

	/* Mobile: image below CTA (2026-08-30, FIX 2026-08-30 take 2). By default
	   each card stacks image -> text -> buttons (DOM order), and .cards-grid__info
	   carries the 1.6rem gap (section-grid-banner.css) that separates it from
	   the image ABOVE it. When this section's "Mobile: image below CTA" setting
	   is on, we reorder via flex `order` on mobile only so the image renders
	   after the text/button block.
	   ROOT CAUSE of the first version of this fix not working: `order` only
	   affects DIRECT flex children of the flex container (.cards-grid__item-block,
	   flex-column, from section-grid-banner.css). When a card's "Button link"
	   setting is filled in, the markup wraps the image in
	   `<a class="cards-grid__image_link">`, and THAT anchor -- not the
	   `.cards-grid__image` div nested inside it -- becomes the actual flex
	   child. Setting `order` on the nested `.cards-grid__image` therefore did
	   nothing whenever a button link was present, which is the common case
	   (exactly what the screenshot showed: image still on top). Using the
	   direct-child combinator `>` targets whichever element actually sits
	   directly under `.cards-grid__item-block` -- the bare image div when no
	   link is set, or the `<a>` wrapper when one is -- so this now reorders
	   correctly either way, and never double-applies to both (the nested,
	   non-direct-child .cards-grid__image inside a link wrapper is excluded by
	   the same combinator, avoiding a doubled margin-top). Gap value now reads
	   var(--modus-space-s) (2026-09-07), the same shared "image<->text stacked"
	   token used everywhere else, instead of a separate hardcoded 1.6rem. */
	{% if section.settings.image_below_cta_mobile %}
	@media screen and (max-width: 749px) {
		#shopify-section-{{ section.id }} .cards-grid__item-block > .cards-grid__image,
		#shopify-section-{{ section.id }} .cards-grid__item-block > .cards-grid__image_link {
			order: 2;
			margin-top: var(--modus-space-s);
		}
		#shopify-section-{{ section.id }} .cards-grid__info {
			order: 1;
			margin-top: 0;
		}
	}
	{% endif %}

	/* ── Mobile slider ── */
	{% if mobile_slider %}
	@media screen and (max-width: 749px) {
		#shopify-section-{{ section.id }} .cards-grid__wrapper--slider {
			display: flex;
			flex-direction: row;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
			/* Spacing between slides lives on the flex container (gap), not as
			   padding inside each card (2026-09-25). The old per-card
			   padding-right made every card box wider than its own content
			   (image, text and buttons stopped 10px short of the card edge),
			   and since the last card had no padding it came out wider than
			   the others. With gap, each card's content fills the card edge
			   to edge, and in 2-up mode the two cards exactly fill the
			   section width: basis = (100% - gap) / 2. */
			gap: {{ section.settings.mobile_gap }}px !important;
			row-gap: 0 !important;
			padding-bottom: 1.6rem;
		}
		#shopify-section-{{ section.id }} .cards-grid__wrapper--slider::-webkit-scrollbar {
			display: none;
		}
		/* Cards per view (default 85% = 1 card, with a peek of the next one).
		   The "Mobile slider: cards visible" setting swaps this to 50% so two
		   cards sit side by side in the viewport at once -- the scroll-snap,
		   overflow-x and dots/pagination behavior below is unchanged either
		   way, only how much of the row is visible per swipe changes. */
		#shopify-section-{{ section.id }} .cards-grid__wrapper--slider .cards-grid__item {
			flex: 0 0 {{ mobile_slider_item_basis }};
			scroll-snap-align: start;
			grid-column-start: auto !important;
			grid-column-end: auto !important;
			grid-row-start: auto !important;
			grid-row-end: auto !important;
			min-width: 0;
			padding-right: 0;
		}
		/* Dots */
		#shopify-section-{{ section.id }} .cards-grid__dots {
			display: flex;
			justify-content: center;
			gap: 6px;
			padding-top: 0.8rem;
		}
		#shopify-section-{{ section.id }} .cards-grid__dots button {
			width: 8px;
			height: 8px;
			border-radius: 50%;
			border: none;
			padding: 0;
			cursor: pointer;
			background-color: currentColor;
			opacity: 0.25;
			transition: opacity 0.2s;
		}
		#shopify-section-{{ section.id }} .cards-grid__dots button.is-active {
			opacity: 1;
		}
	}
	{% endif %}
{%- endstyle -%}

<div class="cards-grid section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} background">
	{% render 'section-header' %}
	<div class="container">
		<div
			class="cards-grid__wrapper{% if mobile_slider %} cards-grid__wrapper--slider{% endif %}"
			{% if mobile_slider %}data-slider-id="{{ section.id }}"{% endif %}
		>
			{%- for block in section.blocks -%}
				<div
					class="cards-grid__item"
					{{ block.shopify_attributes }}
					data-id="{{ block.id }}"
					{%- unless section.settings.auto_layout -%}
						style="grid-column-start: {{ block.settings.column_start }}; grid-column-end: {{ block.settings.column_end }}; grid-row-start: {{ block.settings.row_start }}; grid-row-end: {{ block.settings.row_end }};"
					{%- endunless -%}
				>
					<div class="cards-grid__item-block">
						{% if block.settings.button_link != blank %}
							<a href="{{ block.settings.button_link }}" class="full-unstyled-link cards-grid__image_link">
						{% endif %}
							<div class="cards-grid__image have-overlay">
								{% liquid
									assign media_size = block.settings.image_ratio | default: section.settings.image_ratio
									case media_size
										when 'landscape'
											assign image_size = '50%'
										when 'portrait'
											assign image_size = '125%'
										when 'square'
											assign image_size = '100%'
										else
											assign image_size = '100%'
									endcase
								%}
								{% style %}
									[data-id="{{ block.id }}"] .have-overlay {
										--overlay-alpha: {{ block.settings.overlay_opacity }}%;
									}
									[data-id="{{ block.id }}"] {
										--image_size: {{ image_size }};
									}
								{% endstyle %}
								{%- if block.settings.image != blank and block.settings.video == blank -%}
									{%- assign image_height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio -%}
									{{ block.settings.image | image_url: width: 3840 | image_tag: loading: 'lazy', sizes: '100vw, (min-width: 1023px) 50vw', widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840', height: image_height, animation-images: '' }}
								{%- elsif block.settings.video != blank -%}
									{{ block.settings.video | video_tag: image_size: '1100x', autoplay: true, loop: true, controls: false, muted: true, animation-images: '' }}
								{%- else %}
									{% assign image_index = forloop.index | modulo: 6 | plus: 1 %}
									{{ 'collection-' | append: image_index | placeholder_svg_tag: ' placeholder' }}
								{%- endif -%}
							</div>
						{% if block.settings.button_link != blank %}
							</a>
						{% endif %}

						<div class="cards-grid__info{% if section.settings.enable_divider_line %} enable_border{% endif %}" style="text-align: {{ section.settings.text_horizontal }}">
							<div class="cards-grid__info-block">
								<div class="cards-grid__info-item">
									{%- if block.settings.subheading != blank -%}
										<div class="subtitle">{{ block.settings.subheading }}</div>
									{%- endif -%}
									{%- if block.settings.heading != blank -%}
										{% capture grid_banner_block_heading_inner %}{{ block.settings.heading }}{% endcapture %}
										{%- assign heading_class = 'cards-grid__heading ' | append: block.settings.heading_size -%}
										{% render 'heading-element', tag: block.settings.heading_tag, default_tag: 'h3', class: heading_class, content: grid_banner_block_heading_inner %}
									{%- endif -%}
									{%- if block.settings.text != blank -%}
										<div class="richtext__content cards-grid-text">{{ block.settings.text }}</div>
									{%- endif -%}
									{%- if block.settings.text_2 != blank -%}
										<div class="richtext__content cards-grid__secondary-text">{{ block.settings.text_2 }}</div>
									{%- endif -%}
								</div>
								{%- if block.settings.button_label != blank or block.settings.button_label_2 != blank -%}
									<div class="cards-grid__info-item-btns">
										{%- if block.settings.button_label != blank -%}
											<a href="{{ block.settings.button_link }}" class="button button--{{ block.settings.button_style }} button--cta">{{ block.settings.button_label }}</a>
										{%- endif -%}
										{%- if block.settings.button_label_2 != blank -%}
											<a href="{{ block.settings.button_link_2 }}" class="button button--{{ block.settings.button_style_2 }} button--cta">{{ block.settings.button_label_2 }}</a>
										{%- endif -%}
									</div>
								{%- endif -%}
							</div>
						</div>
					</div>
				</div>
			{%- endfor -%}
		</div>
		{% if mobile_slider %}
		<div class="cards-grid__dots" data-dots-for="{{ section.id }}" aria-hidden="true">
			{% for block in section.blocks %}
				<button type="button" aria-label="Slide {{ forloop.index }}"{% if forloop.first %} class="is-active"{% endif %}></button>
			{% endfor %}
		</div>
		{% endif %}
	</div>
	{% if section.settings.section_header_type == 'type1' and section.settings.button_label != blank %}
		<div class="section-header_btn container">
			{% render 'button', layout: section %}
		</div>
	{% endif %}
</div>

{% if mobile_slider %}
<script>
(function() {
	var slider = document.querySelector('[data-slider-id="{{ section.id }}"]');
	var dotsContainer = document.querySelector('[data-dots-for="{{ section.id }}"]');
	if (!slider || !dotsContainer) return;
	var dots = Array.from(dotsContainer.querySelectorAll('button'));
	var items = Array.from(slider.querySelectorAll('.cards-grid__item'));
	if (!items.length || !dots.length) return;

	function getActiveIndex() {
		var scrollLeft = slider.scrollLeft;
		var step = items.length > 1 ? items[1].offsetLeft - items[0].offsetLeft : items[0].offsetWidth;
		return Math.round(scrollLeft / step);
	}

	function updateDots(index) {
		dots.forEach(function(dot, i) {
			dot.classList.toggle('is-active', i === index);
		});
	}

	slider.addEventListener('scroll', function() {
		updateDots(getActiveIndex());
	}, { passive: true });

	dots.forEach(function(dot, i) {
		dot.addEventListener('click', function() {
			slider.scrollTo({ left: items[i].offsetLeft, behavior: 'smooth' });
		});
	});

	// Only activate slider CSS on mobile
	function checkViewport() {
		if (window.innerWidth >= 750) {
			dotsContainer.style.display = 'none';
		} else {
			dotsContainer.style.display = '';
		}
	}
	checkViewport();
	window.addEventListener('resize', checkViewport);
})();
</script>
{% endif %}

{% schema %}
{
	"name": "t:sections.cards-grid.name",
	"class": "spaced-section cards-grid-section",
	"tag": "section",
	"max_blocks": 8,
	"enabled_on": { "templates": ["*"] },
	"settings": [
		{ "type": "range", "id": "columns", "min": 1, "max": 4, "step": 1, "default": 3, "label": "t:sections.cards-grid.settings.columns.label", "info": "t:sections.cards-grid.settings.columns.info" },
		{ "type": "checkbox", "id": "auto_layout", "default": true, "label": "Auto-arrange cards in order", "info": "Cards automatically fill the grid in order, left to right, using Grid cells amount as cards per row. Turn off to manually position each card via its own Grid position settings (advanced)." },
		{ "type": "checkbox", "id": "mobile_slider", "default": false, "label": "Mobile slider", "info": "On mobile, cards scroll horizontally as a swipeable slider instead of stacking vertically." },
		{ "type": "select", "id": "mobile_slider_columns", "options": [ { "value": "1", "label": "1 card" }, { "value": "2", "label": "2 cards" } ], "default": "2", "label": "Mobile slider: cards visible", "info": "Only applies when Mobile slider is on. Shows one or two cards per view -- swiping still works the same either way." },
		{ "type": "range", "id": "mobile_gap", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 10, "label": "Mobile: spacing between cards", "info": "Gap between cards on mobile — applies to the stacked layout and the slider layout." },
		{ "type": "checkbox", "id": "image_below_cta_mobile", "default": false, "label": "Mobile: image below CTA", "info": "On mobile, moves each card's image below its text and buttons instead of above them, with matching spacing." },
		{ "type": "checkbox", "id": "enable_divider_line", "default": false, "label": "Show divider line above card info" },
		{ "type": "color_scheme", "id": "color_scheme", "default": "background-1", "label": "t:sections.all.color_scheme.label" },
		{ "type": "select", "id": "section_header_type", "label": "t:sections.all.section_header.header.content", "default": "type1", "options": [ { "value": "type1", "label": "t:sections.all.section_header.options.options__1.label" }, { "value": "type2", "label": "t:sections.all.section_header.options.options__2.label" } ] },
		{ "type": "checkbox", "id": "enable_border_top", "default": false, "label": "t:sections.all.section_header.border" },
		{ "type": "text", "id": "subheading", "default": "t:sections.cards-grid.settings.subheading.default", "label": "t:sections.all.subheading.label" },
		{ "type": "inline_richtext", "id": "heading", "default": "t:sections.cards-grid.settings.heading.default", "label": "t:sections.all.heading.label" },
