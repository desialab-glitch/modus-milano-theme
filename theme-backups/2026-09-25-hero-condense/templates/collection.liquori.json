    "produttore_liquori": {"type": "image-with-text", "name": "Il produttore", "settings": {"blocks_type": "type2", "image_position": "image_right", "color_variant": "orange", "color_scheme": "background-1", "image_first": "shopify://shop_images/619222411_18083074208179789_3257937433662929299_n.jpg", "image_ratio": "landscape", "enable_dual_media": false, "producer_logo": "shopify://shop_images/ChatGPT_Image_Jun_30_2026_11_14_54_AM.png", "producer_logo_width_mobile": 35, "producer_logo_width_desktop": 20, "subheading_secondary": "Un liquorificio artigianale a Centola", "heading_tag": "h2", "heading": "", "text": "<p>Theodora è nata a Centola, terra di erbe selvatiche e frutti profumati: qui crescono il mirto, il finocchietto, gli agrumi, le albicocche. Le erbe e i frutti che finiscono nei suoi liquori si raccolgono nelle zone intorno al laboratorio.</p><p>Theodora usa i frutti per intero, scarti compresi, per fare liquori, confetture e marmellate. Le ricette sono quelle di famiglia, tramandate di generazione in generazione.</p>", "cta_1_label": "", "cta_1_link": "", "cta_1_style": "primary", "cta_2_label": "", "cta_2_link": "", "cta_2_style": "secondary", "margin_top": "no-indent", "margin_bottom": "no-indent", "padding_top": "s", "padding_bottom": "m"}},
