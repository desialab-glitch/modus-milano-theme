{{ 'component-article-card.css' | asset_url | stylesheet_tag }}

{% style %}
  {% render 'section-padding' %}
  {% render 'section-margin' %}

  .modus-related .container { max-width: var(--page-width, 132rem); margin: 0 auto; padding: 0 2rem; }
  .modus-related__header { display: flex; flex-direction: column; align-items: flex-start; margin-bottom: 2.4rem; gap: .6rem; }
  .modus-related__subheading {
    font-family: var(--font-body-family);
    font-style: italic;
    font-weight: 400;
    font-size: 14px;
    line-height: 26px;
    color: #4d4d4d;
    text-transform: none;
    letter-spacing: 0;
    margin: 0;
  }
  .modus-related__heading { margin: 0; font-size: clamp(2rem, 2.4vw, 2.6rem); line-height: 1.15; }
  .modus-related__grid {
    display: grid;
    grid-template-columns: repeat(var(--per-row, 4), 1fr);
    gap: 2.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media screen and (max-width: 989px) { .modus-related__grid { --per-row: 2; } }
  @media screen and (max-width: 599px) { .modus-related__grid { --per-row: 1; } }
  .modus-related__cta { display: flex; justify-content: center; margin-top: 3.2rem; }
{% endstyle %}

<section class="modus-related section-{{ section.id }}">
  <div class="container">

    <div class="modus-related__header">
      <p class="modus-related__subheading">{{ section.settings.subheading }}</p>
      <h2 class="modus-related__heading">{{ section.settings.heading }}</h2>
    </div>

    {%- liquid
      assign primary_tag = article.tags | first
      assign max_cards = 4
      assign shown_ids = ""
      assign card_count = 0
    -%}

    <ul class="modus-related__grid">

      {%- comment -%} Phase 1: articles that share the primary tag {%- endcomment -%}
      {% for a in blog.articles %}
        {% if card_count >= max_cards %}{% break %}{% endif %}
        {% if a.id != article.id %}
          {% if primary_tag != blank %}
            {% if a.tags contains primary_tag %}
              <li>
                {% render 'article-card',
                  article: a,
                  show_image: true,
                  show_tags: true,
                  show_date: true,
                  show_excerpt: true,
                  show_author: false,
                  image_ratio: 'portrait',
                  image_fit: 'cover',
                  card_type: 'default',
                  heading_size: 'h3',
                  hover_effect: 'zoom',
                  show_btn: false
                %}
              </li>
              {%- assign shown_ids = shown_ids | append: a.id | append: "," -%}
              {%- assign card_count = card_count | plus: 1 -%}
            {% endif %}
          {% endif %}
        {% endif %}
      {% endfor %}

      {%- comment -%} Phase 2: fill remaining slots with other recent articles {%- endcomment -%}
      {% for a in blog.articles %}
        {% if card_count >= max_cards %}{% break %}{% endif %}
        {% if a.id != article.id %}
          {%- assign a_id_marker = a.id | append: "," -%}
          {% unless shown_ids contains a_id_marker %}
            <li>
              {% render 'article-card',
                article: a,
                show_image: true,
                show_tags: true,
                show_date: true,
                show_excerpt: true,
                show_author: false,
                image_ratio: 'portrait',
                image_fit: 'cover',
                card_type: 'default',
                heading_size: 'h3',
                hover_effect: 'zoom',
                show_btn: false
              %}
            </li>
            {%- assign shown_ids = shown_ids | append: a.id | append: "," -%}
            {%- assign card_count = card_count | plus: 1 -%}
          {% endunless %}
        {% endif %}
      {% endfor %}

    </ul>

    {% if section.settings.button_label != blank %}
      <div class="modus-related__cta">
        <a href="{{ blog.url }}" class="button button--primary button--cta">{{ section.settings.button_label }}</a>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Articoli correlati",
  "tag": "section",
  "class": "section-modus-related",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Soprattitolo", "default": "Continua a leggere" },
    { "type": "text", "id": "heading", "label": "Titolo sezione", "default": "Dal Journal Modus" },
    { "type": "text", "id": "button_label", "label": "Testo CTA", "default": "Tutti gli articoli" },
    { "type": "header", "content": "Margini" },
    {
      "type": "select", "id": "margin_top", "label": "Margine superiore",
      "options": [
        { "value": "no-indent", "label": "Nessuno" },
        { "value": "xs", "label": "XS" },
        { "value": "s", "label": "S" },
        { "value": "m", "label": "M" },
        { "value": "l", "label": "L" }
      ],
      "default": "m"
    },
    {
      "type": "select", "id": "margin_bottom", "label": "Margine inferiore",
      "options": [
        { "value": "no-indent", "label": "Nessuno" },
        { "value": "xs", "label": "XS" },
        { "value": "s", "label": "S" },
        { "value": "m", "label": "M" },
        { "value": "l", "label": "L" }
      ],
      "default": "l"
    }
  ]
}
{% endschema %}
