{% liquid
	assign grid_products = collections.all.products
	assign collection_handle = 'all'
	assign base_url = routes.all_products_collection_url
	assign total_shop_products = shop.products_count | default: 0

	if section.settings.collection != blank
		assign grid_products = section.settings.collection.products
		assign collection_handle = section.settings.collection.handle
		assign base_url = routes.collections_url | append: '/' | append: collection_handle
		assign total_shop_products = section.settings.collection.all_products_count
	endif

	if section.settings.product_list != blank
		assign grid_products = section.settings.product_list
		assign collection_handle = 'all'
		assign base_url = 'none'
		assign total_shop_products = section.settings.product_list.size
	endif

	assign sort = section.settings.sort

	case section.settings.sort
		when 'alphabetical'
		assign sort ='title-ascending'
		when 'alphabetical_reversed'
		assign sort ='title-descending'
		when 'products_high'
		assign sort ='price-descending'
		when 'products_low'
		assign sort ='price-ascending'
		when 'date'
		assign sort ='created-ascending'
		when 'date_reversed'
		assign sort ='created-descending'
		else
		assign sort = 'manual'
	endcase

	case sort
		when 'title-ascending', 'title-descending'
		assign grid_products = grid_products | sort: 'title'
		when 'price-descending', 'price-ascending'
		assign grid_products = grid_products | sort: 'price_min'
		when 'created-ascending', 'created-descending'
		assign grid_products = grid_products | sort: 'published_at'
		when 'manual'
		assign grid_products = grid_products | sort: 'manual'
		when 'best-selling'
		assign grid_products = grid_products | sort: 'manual'
	endcase

	 if sort == 'price-descending' or sort == 'created-descending' or sort == 'title-descending'
		assign grid_products = grid_products | reverse
	endif

	assign is_dynamic_loading = false
  if total_shop_products > 50
    assign is_dynamic_loading = true
  elsif sort == 'manual' or sort == 'best-selling'
    if base_url != 'none'
      assign is_dynamic_loading = true
    endif
  endif

  if is_dynamic_loading and base_url != 'none'
    assign sort_params = '?sort_by=' | append: sort
    assign collection_url = base_url | append: sort_params | append: '&section_id=' | append: section.id
    assign grid_products = collection.products
  else
    assign collection_url = 'none'
  endif

  assign visible_product_count = grid_products.size | at_most: section.settings.products_per_page
  assign slider_active = false
  if section.settings.mobile_slider and visible_product_count > 2
    assign slider_active = true
  endif
  assign mobile_gap_px = section.settings.mobile_gap | default: 10
  assign mobile_gap_half = mobile_gap_px | divided_by: 2
  assign section_id = 'shopify-section-' | append: section.id
  assign mobile_product_list = grid_products | slice: 0, visible_product_count
%}

{%- style -%}
	{% render 'section-padding' %}
	{% assign cols = section.settings.columns_per_row %}
	{% assign cols_mid = cols | at_most: 3 %}
	{% assign cols_sm = cols | at_most: 2 %}
	@media screen and (min-width: 576px) {
		#shopify-section-{{ section.id }} .collection-product-list {
			grid-template-columns: repeat({{ cols_sm }}, 1fr) !important;
		}
	}
	@media screen and (min-width: 990px) {
		#shopify-section-{{ section.id }} .collection-product-list {
			grid-template-columns: repeat({{ cols_mid }}, 1fr) !important;
		}
	}
	@media screen and (min-width: 1150px) {
		#shopify-section-{{ section.id }} .collection-product-list {
			grid-template-columns: repeat({{ cols }}, 1fr) !important;
		}
	}
	#shopify-section-{{ section.id }} .subtitle {
		font-style: italic;
		opacity: 0.8;
	}
	{% if section.settings.anchor_id != blank %}
	#shopify-section-{{ section.id }} {
		scroll-margin-top: var(--header-height, 0px);
	}
	{% endif %}

	/* Mobile slider (2026-09-07, rebuilt): reuses the same 'products-slider'
	   snippet + popular-products.js Swiper driver that already powers the
	   working mobile slider on the "popular-products" section (2 cards/row,
	   round pagination dots). Below 750px, only when "Mobile slider" is on
	   and there are more than 2 products, the real desktop CSS grid is
	   hidden and a separate Swiper block takes over; at 750px and above the
	   original multi-row CSS grid is shown and the Swiper block is hidden.
	   The two blocks are fully independent so the desktop/tablet grid
	   (which can span many rows for large collections) is never touched. */
	/* FIX 2026-09-22: this slider_active check used to sit above the
	   product-count assign logic that defines it, so it always read as
	   undefined and the hide/show media queries below never emitted --
	   on any collection with more than 2 products, the desktop grid and
	   the mobile slider both rendered visible at every viewport width,
	   doubling every product card on screen. The assign logic now runs
	   before this style block instead; nothing else changed. */
	{% if slider_active %}
	@media screen and (max-width: 749px) {
		#shopify-section-{{ section.id }} .products-grid-desktop-list {
			display: none !important;
		}
	}
	@media screen and (min-width: 750px) {
		#shopify-section-{{ section.id }} .products-grid-mobile-slider {
			display: none !important;
		}
	}
	{% endif %}
{%- endstyle -%}


<div class="products-grid section-{{ section.id }}-padding {% if is_dynamic_loading %} products-grid--loading{% if collection.products.size > 0 %} products-grid--search-perfomed{% endif %}{% endif %}"
	{%- if section.settings.anchor_id != blank -%}id="{{ section.settings.anchor_id }}"{%- endif -%}
	data-is-dynamic-load="{{ is_dynamic_loading }}"
	data-collection-url="{{ collection_url }}"
>
	<div class="container">
		<div class="section-grid">
			{% render 'section-header', text_size: 'large' %}

			<div class="products-grid full-width content">
				<ul
					id="products-grid"
					data-id="{{ section.id }}"
					class="collection-product-list products-grid-desktop-list {% if section.settings.show_two_cards %} collection-product-list--2-mobile{% endif %}"
				>
					{% if is_dynamic_loading == false or grid_products.size > 0 %}
						{%- for product in grid_products
							limit: section.settings.products_per_page
						-%}
						{% assign image_index = forloop.index0 | modulo: 6 | plus: 1 %}
							<li class="collection-product-card {% if settings.on_hover == "hover"  %}quickview--hover{% endif %}">
								{% render 'product-card',
									product_card_product: product,
									media_size: section.settings.image_ratio,
									media_fit: section.settings.image_fit,
									show_secondary_image: section.settings.show_secondary_image,
									show_vendor: section.settings.show_vendor,
									show_color_swatch: section.settings.show_color_swatch,
									show_desc: section.settings.show_desc,
									section_id: section.id,
									add_id: forloop.index,
									show_sku: section.settings.show_sku,
									text_alignment: settings.card_text_alignment,
									image_index: image_index,
									product_card_heading_tag: section.settings.product_card_heading_tag
								%}
							</li>
						{%- endfor -%}
					{% else %}
						{%- for i in (1..4) -%}
							{% assign image_index = forloop.index | modulo: 6 | plus: 1 %}
							<div class="popular-products__item_placeholder collection-popular-card collection-popular-card--placeholder">
								{% render 'product-card-placeholder',
									media_ratio: section.settings.image_ratio,
									show_vendor: section.settings.show_vendor,
									image_index: image_index
								%}
							</div>
						{%- endfor -%}
					{% endif %}
				</ul>
				{% if slider_active %}
				<div class="products-grid-mobile-slider">
					{% render 'products-slider',
						slider_settings: section.settings,
						product_list: mobile_product_list,
						section_id: section_id,
						container: false,
						layout_type: 'slider',
						per_row_override: section.settings.columns_per_row,
						image_ratio_override: section.settings.image_ratio
					%}
				</div>
				{% endif %}
			</div>
		</div>
	</div>
	</div>

{% schema %}
{
	"name": "t:sections.products-grid.name",
	"tag": "section",
	"class": "products-grid-section",
	"disabled_on": {
		"templates": ["password"],
		"groups": ["*"]
	},
	"settings": [
		{
			"type": "collection",
			"id": "collection",
			"label": "t:sections.products-grid.settings.collection.label"
		},
		{
			"type": "product_list",
			"id": "product_list",
			"label": "t:sections.products-grid.settings.product_list.label",
			"info": "t:sections.products-grid.settings.product_list.info",
			"limit": 50
		},
		{
			"type": "text",
			"id": "anchor_id",
			"label": "ID ancora (per link CTA, es. da un hero)",
			"info": "Se impostato, un pulsante altrove nella pagina può usare #id-ancora per scorrere fino a qui. Deve essere univoco nella pagina."
		},
		{
			"type": "paragraph",
			"content": "t:sections.products-grid.settings.text_about_products.content"
		},
		{
			"type": "paragraph",
			"content": "t:sections.products-grid.settings.text_about_dynamic.content"
		},
		{
			"type": "text",
			"id": "subheading",
			"label": "Subheading"
		},
		{
			"type": "inline_richtext",
			"id": "heading",
			"default": "t:sections.products-grid.settings.heading.default",
			"label": "t:sections.all.heading.label"
		},
		{
			"type": "select",
			"id": "heading_tag",
			"label": "t:sections.all.heading.tag.label",
			"info": "t:sections.all.heading.tag.info",
			"options": [
				{ "value": "h1", "label": "t:sections.all.heading.tag.options.h1.label" },
				{ "value": "h2", "label": "t:sections.all.heading.tag.options.h2.label" },
				{ "value": "h3", "label": "t:sections.all.heading.tag.options.h3.label" },
				{ "value": "h4", "label": "t:sections.all.heading.tag.options.h4.label" },
				{ "value": "h5", "label": "t:sections.all.heading.tag.options.h5.label" },
				{ "value": "h6", "label": "t:sections.all.heading.tag.options.h6.label" },
				{ "value": "div", "label": "t:sections.all.heading.tag.options.div.label" },
				{ "value": "span", "label": "t:sections.all.heading.tag.options.span.label" },
				{ "value": "p", "label": "t:sections.all.heading.tag.options.p.label" }
			],
			"default": "h2"
		},
		{
			"type": "select",
			"id": "product_card_heading_tag",
			"label": "t:sections.all.heading.product_card_tag.label",
			"info": "t:sections.all.heading.tag.info",
			"options": [
				{ "value": "h1", "label": "t:sections.all.heading.tag.options.h1.label" },
				{ "value": "h2", "label": "t:sections.all.heading.tag.options.h2.label" },
				{ "value": "h3", "label": "t:sections.all.heading.tag.options.h3.label" },
				{ "value": "h4", "label": "t:sections.all.heading.tag.options.h4.label" },
				{ "value": "h5", "label": "t:sections.all.heading.tag.options.h5.label" },
				{ "value": "h6", "label": "t:sections.all.heading.tag.options.h6.label" },
				{ "value": "div", "label": "t:sections.all.heading.tag.options.div.label" },
				{ "value": "span", "label": "t:sections.all.heading.tag.options.span.label" },
				{ "value": "p", "label": "t:sections.all.heading.tag.options.p.label" }
			],
			"default": "h3"
		},
		{
			"type": "richtext",
			"id": "description",
			"default": "t:sections.products-grid.settings.description.default",
			"label": "t:sections.all.text.label"
		},
		{
			"type": "text_alignment",
			"id": "alignment",
			"label": "t:sections.all.content_alignment.label",
			"default": "center"
		},
		{
			"type": "range",
			"id": "columns_per_row",
			"min": 1,
			"max": 4,
			"step": 1,
			"default": 2,
			"label": "Columns per row (desktop)"
		},
		{
			"type": "range",
			"id": "products_per_page",
			"min": 2,
			"max": 50,
			"step": 1,
			"default": 8,
			"label": "t:sections.products-grid.settings.products_per_page.label"
		},
		{
			"type": "select",
			"id": "sort",
			"options": [
				{ "value": "alphabetical", "label": "t:sections.products-grid.settings.sort.options__1.label" },
				{ "value": "alphabetical_reversed", "label": "t:sections.products-grid.settings.sort.options__2.label" },
				{ "value": "date_reversed", "label": "t:sections.products-grid.settings.sort.options__3.label" },
				{ "value": "date", "label": "t:sections.products-grid.settings.sort.options__4.label" },
				{ "value": "products_high", "label": "t:sections.products-grid.settings.sort.options__5.label" },
				{ "value": "products_low", "label": "t:sections.products-grid.settings.sort.options__6.label" },
				{ "value": "manual", "label": "t:sections.products-grid.settings.sort.options__7.label" },
				{ "value": "best-selling", "label": "t:sections.products-grid.settings.sort.options__8.label" }
			],
			"default": "alphabetical",
			"label": "t:sections.products-grid.settings.sort.label",
			"info": "t:sections.products-grid.settings.sort.info"
		},
		{
			"type": "header",
			"content": "t:sections.all.product_card.header.content"
		},
		{
			"type": "checkbox",
			"id": "show_two_cards",
			"default": true,
			"label": "t:sections.all.product_card.mobile_card_count.label"
		},
		{
			"type": "checkbox",
			"id": "mobile_slider",
			"default": true,
			"label": "Mobile slider",
			"info": "When there are more than 2 products, they scroll horizontally as a swipeable slider on mobile (with round pagination dots) instead of wrapping to more rows. With 2 or fewer products this has no effect. Works together with the mobile card-count setting above: with it on, 2 cards are visible per screen and the slider reveals more pairs; with it off, one card is shown at a time with a peek of the next."
		},
		{
			"type": "checkbox",
			"id": "show_arrows",
			"default": true,
			"label": "Mobile slider: show pagination dots"
		},
		{
			"type": "range",
			"id": "mobile_gap",
			"min": 0,
			"max": 40,
			"step": 2,
			"unit": "px",
			"default": 10,
			"label": "Mobile: spacing between cards",
			"info": "Gap between cards when Mobile slider is enabled."
		},
		{
			"type": "checkbox",
			"id": "show_secondary_image",
			"default": true,
			"label": "t:sections.all.product_card.show_secondary_image.label"
		},
		{
			"type": "checkbox",
			"id": "show_sku",
			"default": false,
			"label": "t:sections.all.sku.show_sku"
		},
		{
			"type": "checkbox",
			"id": "show_vendor",
			"default": true,
			"label": "t:sections.all.product_card.show_vendor.label"
		},
		{
			"type": "checkbox",
			"id": "show_desc",
			"default": false,
			"label": "t:sections.all.product_card.show_description.label"
		},
		{
			"type": "checkbox",
			"id": "show_color_swatch",
			"default": false,
			"label": "t:sections.all.product_card.show_color.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.image.header.content"
		},
		{
			"type": "select",
			"id": "image_ratio",
			"options": [
				{ "value": "landscape", "label": "t:sections.all.image.ratio.options__1.label" },
				{ "value": "portrait", "label": "t:sections.all.image.ratio.options__2.label" },
				{ "value": "square", "label": "t:sections.all.image.ratio.options__3.label" }
			],
			"default": "portrait",
			"label": "t:sections.all.image.ratio.label"
		},
		{
			"type": "select",
			"id": "image_fit",
			"label": "t:sections.all.image.fit.label",
			"options": [
				{ "value": "contain", "label": "t:sections.all.image.fit.options__1.label" },
				{ "value": "cover", "label": "t:sections.all.image.fit.options__2.label" }
			],
			"default": "cover"
		},
		{
			"type": "header",
			"content": "t:sections.all.section-padding.header.content"
		},
		{
			"type": "select",
			"id": "padding_top",
			"options": [
				{ "value": "no-indent", "label": "t:sections.all.section-padding.options__1.label" },
				{ "value": "xs", "label": "t:sections.all.section-padding.options__2.label" },
				{ "value": "s", "label": "t:sections.all.section-padding.options__3.label" },
				{ "value": "m", "label": "t:sections.all.section-padding.options__4.label" },
				{ "value": "l", "label": "t:sections.all.section-padding.options__5.label" }
			],
			"default": "m",
			"label": "t:sections.all.section-padding.padding_top.label"
		},
		{
			"type": "select",
			"id": "padding_bottom",
			"options": [
				{ "value": "no-indent", "label": "t:sections.all.section-padding.options__1.label" },
				{ "value": "xs", "label": "t:sections.all.section-padding.options__2.label" },
				{ "value": "s", "label": "t:sections.all.section-padding.options__3.label" },
				{ "value": "m", "label": "t:sections.all.section-padding.options__4.label" },
				{ "value": "l", "label": "t:sections.all.section-padding.options__5.label" }
			],
			"default": "m",
			"label": "t:sections.all.section-padding.padding_bottom.label"
		}
	],
	"presets": [
		{
			"name": "t:sections.products-grid.name"
		}
	]
}
{% endschema %}
