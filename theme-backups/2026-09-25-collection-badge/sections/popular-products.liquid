{{ 'section-popular-products.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
<script src='{{ 'product-card-slider.js' | asset_url }}' defer='defer'></script>
<script
	src='{{ 'popular-products.js' | asset_url }}'
	defer='defer'
></script>

{% assign product_list = section.settings.product_list %}
{% assign section_id = 'shopify-section-' | append: section.id %}

{%- comment -%}
  Dynamic columns: cap per_row to actual product count.
  per_row setting becomes a "maximum columns" cap, not a fixed value.
  1 product = 1 col (no artificial minimum).
{%- endcomment -%}
{% assign actual_per_row = product_list.size | at_most: section.settings.per_row %}
{% if actual_per_row < 1 %}{% assign actual_per_row = 1 %}{% endif %}

{%- comment -%}
  Dynamic image ratio based on column count:
  4+ cols → portrait  (tall cards)
  3 cols  → square    (balanced)
  ≤2 cols → landscape (wide cards)
{%- endcomment -%}
{% if actual_per_row >= 4 %}
  {% assign actual_image_ratio = 'portrait' %}
{% elsif actual_per_row == 3 %}
  {% assign actual_image_ratio = 'square' %}
{% else %}
  {% assign actual_image_ratio = 'landscape' %}
{% endif %}

{% style %}
	{% render 'section-margin' %}
	#shopify-section-{{ section.id }} {
		--perRow: {{ actual_per_row }};
	}
	/* Subheading — Modus design system (2026-08-29: 14px -> 15px to match the
	   sitewide subheading/eyebrow convention; shared by this section's own
	   eyebrow and the product-card vendor line below, both of which use the
	   generic .subtitle treatment, not a distinct card-level micro-label like
	   .card__collection-title). */
	#shopify-section-{{ section.id }} .subtitle,
	#shopify-section-{{ section.id }} .section-header__subheading {
		font-family: 'Lora', serif !important;
		font-style: italic !important;
		font-weight: 400 !important;
		font-size: 15px !important;
		line-height: 26px !important;
		letter-spacing: 0 !important;
		color: #4d4d4d !important;
		text-transform: none !important;
		margin: 0 0 0.4rem !important;
	}

	/* Vendor line keeps the plain italic subtitle style above — no change needed,
	   it's matched by the generic .subtitle rule and nothing else touches it. */

	/* The rule above is shared with the product-card vendor line, which
	   intentionally keeps a tight 0.4rem. The top section header's own
	   eyebrow needs the sitewide eyebrow -> heading gap instead, so this
	   scopes a more specific override to just the section-header wrapper
	   (ID + 2 classes beats the ID + 1 class rule above). Tokenized to
	   var(--modus-space-xs) (2026-09-07, was hardcoded 1.2rem). */
	#shopify-section-{{ section.id }} .section-header__title-item .subtitle,
	#shopify-section-{{ section.id }} .section-header__title-item .section-header__subheading {
		margin: 0 0 var(--modus-space-xs) !important;
	}

	/* Collection/category tag — the one that links to a collection — matches the
	   primary button exactly (font, weight, letter-spacing, colors, radius),
	   just smaller. No arrow icon — this is a badge, not a CTA button. */
	#shopify-section-{{ section.id }} .card__collection-title {
		display: inline-block !important;
		font-family: 'Antonio', sans-serif !important;
		font-style: normal !important;
		font-weight: 700 !important;
		font-size: 10px !important;
		line-height: 1 !important;
		letter-spacing: 0.2em !important;
		text-transform: uppercase !important;
		color: #ffffff !important;
		background-color: #D16A14 !important;
		border: none !important;
		padding: 5px 8px !important;
		border-radius: 2px !important;
		text-decoration: none !important;
		margin: 0.6rem 0 0.8rem !important;
		transition: none !important;
	}
	#shopify-section-{{ section.id }} .card__collection-title:hover {
		background-color: #01473E !important;
		color: #ffffff !important;
		opacity: 1 !important;
	}

	/* Keep the title heading with its normal top spacing after the badge */
	#shopify-section-{{ section.id }} .card-information-block {
		margin-top: 0;
	}

	/* Mobile: this section always uses the "type1" centered section-header
	   layout (subheading/heading/description centered + auto-margined),
	   unlike most other sections on the site which use the left-aligned
	   "type2" header. On small screens that centered block reads badly next
	   to everything else being left-aligned, so force left alignment here
	   on mobile only; desktop keeps the existing centered layout. (2026-08-30) */
	@media screen and (max-width: 749px) {
		#shopify-section-{{ section.id }} .section-header__title__center .section-header__title-item {
			align-items: flex-start !important;
			text-align: left !important;
			margin: 0 !important;
		}
	}
{% endstyle %}

{% liquid
	if section.settings.show_arrows
		assign show_arrows = true
	else
		assign show_arrows = false
	endif
%}
<div class='popular-products color-{{ section.settings.color_scheme }} background'>
	{% render 'section-header', show_arrows: show_arrows %}
	{% render 'products-slider',
		slider_settings: section.settings,
		product_list: product_list,
		section_id: section_id,
		container: true,
		layout_type: section.settings.mobile_slider_grid_layout,
		per_row_override: actual_per_row,
		image_ratio_override: actual_image_ratio
	%}
	{% if section.settings.section_header_type == 'type1' %}
		<div class='section-header_btn'>
			{% if section.settings.button_label != blank %}
				{% render 'button', layout: section %}
			{% endif %}
		</div>
	{% endif %}
</div>

{% schema %}
{
	"name": "t:sections.popular-products.name",
	"tag": "section",
	"class": "popular-products-section spaced-section",
	"enabled_on": {
		"templates": ["*"]
	},
	"settings": [
		{
			"type": "product_list",
			"id": "product_list",
			"limit": 12,
			"label": "t:sections.all.product_card.product_list.label"
		},
		{
			"type": "range",
			"id": "per_row",
			"min": 2,
			"max": 4,
			"step": 1,
			"default": 4,
			"label": "t:sections.all.column_per_row.label",
			"info": "t:sections.all.column_per_row.info"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"default": "background-1",
			"label": "t:sections.all.color_scheme.label"
		},
		{
			"type": "select",
			"id": "section_header_type",
			"label": "t:sections.all.section_header.header.content",
			"default": "type1",
			"options": [
				{
					"value": "type1",
					"label": "t:sections.all.section_header.options.options__1.label"
				},
				{
					"value": "type2",
					"label": "t:sections.all.section_header.options.options__2.label"
				}
			]
		},
		{
			"type": "select",
			"id": "mobile_slider_grid_layout",
			"options": [
				{
					"value": "slider",
					"label": "t:sections.popular-products.settings.mobile_layout.layout.options_1.label"
				},
				{
					"value": "grid",
					"label": "t:sections.popular-products.settings.mobile_layout.layout.options_2.label"
				}
			],
			"default": "slider",
			"label": "t:sections.popular-products.settings.mobile_layout.label"
		},
		{
			"type": "inline_richtext",
			"id": "heading",
			"default": "t:sections.popular-products.settings.heading.default",
			"label": "t:sections.all.heading.label"
		},
		{
			"type": "select",
			"id": "heading_tag",
			"label": "t:sections.all.heading.tag.label",
			"info": "t:sections.all.heading.tag.info",
			"options": [
				{ "value": "h1", "label": "t:sections.all.heading.tag.options.h1.label" },
				{ "value": "h2", "label": "t:sections.all.heading.tag.options.h2.label" },
				{ "value": "h3", "label": "t:sections.all.heading.tag.options.h3.label" },
				{ "value": "h4", "label": "t:sections.all.heading.tag.options.h4.label" },
				{ "value": "h5", "label": "t:sections.all.heading.tag.options.h5.label" },
				{ "value": "h6", "label": "t:sections.all.heading.tag.options.h6.label" },
				{ "value": "div", "label": "t:sections.all.heading.tag.options.div.label" },
				{ "value": "span", "label": "t:sections.all.heading.tag.options.span.label" },
				{ "value": "p", "label": "t:sections.all.heading.tag.options.p.label" }
			],
			"default": "h2"
		},
		{
			"type": "select",
			"id": "product_card_heading_tag",
			"label": "t:sections.all.heading.product_card_tag.label",
			"info": "t:sections.all.heading.tag.info",
			"options": [
				{ "value": "h1", "label": "t:sections.all.heading.tag.options.h1.label" },
				{ "value": "h2", "label": "t:sections.all.heading.tag.options.h2.label" },
				{ "value": "h3", "label": "t:sections.all.heading.tag.options.h3.label" },
				{ "value": "h4", "label": "t:sections.all.heading.tag.options.h4.label" },
				{ "value": "h5", "label": "t:sections.all.heading.tag.options.h5.label" },
				{ "value": "h6", "label": "t:sections.all.heading.tag.options.h6.label" },
				{ "value": "div", "label": "t:sections.all.heading.tag.options.div.label" },
				{ "value": "span", "label": "t:sections.all.heading.tag.options.span.label" },
				{ "value": "p", "label": "t:sections.all.heading.tag.options.p.label" }
			],
			"default": "h3"
		},
		{
			"type": "text",
			"id": "subheading",
			"default": "t:sections.popular-products.settings.subheading.default",
			"label": "t:sections.compare-block.settings.heading.label"
