{{ 'section-collapsible-content.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collapsible-content.js' | asset_url }}" defer="defer"></script>

{%- style -%}
	{% render 'section-margin' %}
	{% render 'section-padding' %}
	#shopify-section-{{ section.id }} .faqs__header {
		border-bottom: none;
		padding-bottom: 0;
		margin-bottom: 1.6rem;
	}
	/* Remove the ::after padding-bottom:100% that forced a square aspect ratio */
	#shopify-section-{{ section.id }} .collapsible-content__image-wrapper::after {
		display: none !important;
		padding-bottom: 0 !important;
	}
	/* Wrapper: height driven by FAQ content, image stretches to match */
	#shopify-section-{{ section.id }} .collapsible-content-wrapper_with-image {
		align-items: stretch;
	}
	/* Image wrapper: no natural height, stretches to FAQ column height */
	#shopify-section-{{ section.id }} .collapsible-content__image-wrapper {
		position: relative;
		overflow: hidden;
		min-height: 0;
		padding: 0;
	}
	#shopify-section-{{ section.id }} .collapsible-content__image {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		overflow: hidden;
		z-index: 0;
	}
	#shopify-section-{{ section.id }} .collapsible-content__image img,
	#shopify-section-{{ section.id }} .collapsible-content__image video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		display: block;
	}
	#shopify-section-{{ section.id }} .collapsible-content__image-info {
		position: relative;
		z-index: 1;
	}
	/* Uniform padding on all items — first child gets same as rest */
	#shopify-section-{{ section.id }} .collapsible-content-block:first-child .collapsible-content-item {
		padding-top: 1.6rem;
	}
	#shopify-section-{{ section.id }} .collapsible-content-box {
		padding-bottom: 0;
	}
	/* No extra space after the last question (was +24px on every FAQ, none
	   of which has a button); a button, if added, keeps the standard gap. */
	#shopify-section-{{ section.id }} .collapsible-content-block:last-of-type {
		margin-bottom: 0;
	}
	#shopify-section-{{ section.id }} .collapsible-content-box .button {
		margin-top: var(--modus-space-xs);
	}
{%- endstyle -%}

<link
	rel="stylesheet"
	href="{{ 'component-accordion.css' | asset_url }}"
	media="print"
	onload="this.media='all'"
>

<div class="collapsible-content color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding">
	<div class="container">
		{% if section.settings.faqs_heading != blank
			or section.settings.faqs_desc != blank
		%}
			<div class="faqs__header">
				{%- if section.settings.faqs_heading != blank -%}
					<{{ section.settings.heading_tag }} class="faqs__title h2">
						{{ section.settings.faqs_heading }}
					</{{ section.settings.heading_tag }}>
				{%- endif -%}
				{% if section.settings.faqs_desc != blank %}
					<div class="faqs__desc richtext__content">
						{{ section.settings.faqs_desc }}
					</div>
				{% endif %}
			</div>
		{% endif %}
		<div class="collapsible-content-wrapper{% if section.settings.show_image_content %} collapsible-content-wrapper_with-image{% endif %}">
			{% if section.settings.show_image_content %}
				<div class="collapsible-content__image-wrapper color-inverse">
					<div class="collapsible-content__image-info">
						{% if section.settings.subheading != blank %}
							<span class="collapsible-content__subtitle subtitle">
								{{ section.settings.subheading }}
							</span>
						{% endif %}
						{% if section.settings.heading != blank %}
							<{{ section.settings.heading_tag_second }}
								class="collapsible-content__heading h1"
								{% if section.settings.text_animation %}
									data-animation-text="true"
								{% endif %}
							>
								{{ section.settings.heading }}
							</{{ section.settings.heading_tag_second }}>
						{% endif %}
						{% if section.settings.description != blank %}
							<span class="collapsible-content__description medium-font">
							{{ section.settings.description }}
							</span>
						{% endif %}
					</div>

					<div class="collapsible-content__image">
						{% if section.settings.video != blank %}
							{% liquid
								assign video_height = section.settings.video.sources[0].width | divided_by: section.settings.video.aspect_ratio
							%}
							{{
								section.settings.video
								| video_tag:
									width: section.settings.video.sources[0].width,
									height: video_height,
									autoplay: true,
									loop: true,
									controls: false,
									muted: true
							}}
						{%- elsif section.settings.image != blank -%}
							{% assign image_height = section.settings.image.width
								| divided_by: section.settings.image.aspect_ratio
							%}
							{{
								section.settings.image
								| image_url: width: 3840
								| image_tag:
									loading: 'lazy',
									width: section.settings.image.width,
									height: image_height,
									sizes: '100vw',
									widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
							}}
						{%- else -%}
							{{ 'image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
						{%- endif -%}
					</div>
				</div>
			{% endif %}
			<div class="collapsible-content-box">
				{% for block in section.blocks %}
					{% if block.settings.heading != blank
						and block.settings.description != blank
					%}
						<div class="collapsible-content-block">
							<div class="collapsible-content-item">
								<div class="collapsible-content-summary">
									<{{ block.settings.heading_tag }} class="collapsible-content-item__heading h3">
										{{ block.settings.heading }}
									</{{ block.settings.heading_tag }}>
									<div class="collapsible-content-item__icon">
										<span></span>
										<span></span>
									</div>
								</div>
								<div
									class="collapsible-content-item__content"
									{% if forloop.index != 1 %}
										style="display: none"
									{% endif %}
								>
									{%- if block.settings.description != blank -%}
										<div class="collapsible-content-item__description medium-font richtext__content">
											{{ block.settings.description }}
										</div>
									{%- endif -%}
								</div>
							</div>
						</div>
					{%- endif -%}
				{% endfor %}
				{% render 'button', layout: section %}
			</div>
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.collapsible-content.name",
	"class": "collapsible-content-section",
	"tag": "section",
	"enabled_on": {
		"templates": ["*"]
	},
	"settings": [
		{
			"type": "inline_richtext",
			"id": "faqs_heading",
			"label": "t:sections.all.heading.label"
		},
		{
			"type": "select",
			"id": "heading_tag",
			"label": "t:sections.all.heading.tag.label",
			"info": "t:sections.all.heading.tag.info",
			"options": [
				{ "value": "h1", "label": "t:sections.all.heading.tag.options.h1.label" },
				{ "value": "h2", "label": "t:sections.all.heading.tag.options.h2.label" },
				{ "value": "h3", "label": "t:sections.all.heading.tag.options.h3.label" },
				{ "value": "h4", "label": "t:sections.all.heading.tag.options.h4.label" },
				{ "value": "h5", "label": "t:sections.all.heading.tag.options.h5.label" },
				{ "value": "h6", "label": "t:sections.all.heading.tag.options.h6.label" },
				{ "value": "div", "label": "t:sections.all.heading.tag.options.div.label" },
				{ "value": "span", "label": "t:sections.all.heading.tag.options.span.label" },
				{ "value": "p", "label": "t:sections.all.heading.tag.options.p.label" }
			],
			"default": "h2"
		},
		{
			"type": "richtext",
			"id": "faqs_desc",
			"label": "t:sections.all.text.label"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"default": "background-2",
			"label": "t:sections.all.color_scheme.label"
		},
		{
			"type": "checkbox",
			"id": "show_image_content",
			"default": true,
			"label": "t:sections.collapsible-content.settings.show_image_content.label"
		},
		{
			"type": "image_picker",
			"id": "image",
			"label": "t:sections.all.image.label"
		},
		{
			"type": "video",
			"id": "video",
			"label": "t:sections.all.video.label"
		},
		{
			"type": "text",
			"id": "subheading",
			"default": "t:sections.collapsible-content.settings.subheading.default",
			"label": "t:sections.all.subheading.label"
		},
		{
			"type": "inline_richtext",
			"id": "heading",
			"default": "t:sections.collapsible-content.settings.heading.default",
			"label": "t:sections.all.heading.label"
		},
		{
			"type": "select",
			"id": "heading_tag_second",
			"label": "t:sections.all.heading.tag.label",
			"info": "t:sections.all.heading.tag.info",
			"options": [
				{ "value": "h1", "label": "t:sections.all.heading.tag.options.h1.label" },
				{ "value": "h2", "label": "t:sections.all.heading.tag.options.h2.label" },
				{ "value": "h3", "label": "t:sections.all.heading.tag.options.h3.label" },
				{ "value": "h4", "label": "t:sections.all.heading.tag.options.h4.label" },
				{ "value": "h5", "label": "t:sections.all.heading.tag.options.h5.label" },
				{ "value": "h6", "label": "t:sections.all.heading.tag.options.h6.label" },
				{ "value": "div", "label": "t:sections.all.heading.tag.options.div.label" },
				{ "value": "span", "label": "t:sections.all.heading.tag.options.span.label" },
				{ "value": "p", "label": "t:sections.all.heading.tag.options.p.label" }
			],
			"default": "h2"
		},
		{
			"type": "checkbox",
			"id": "text_animation",
			"default": true,
			"label": "t:sections.all.animations.label"
		},
		{
			"type": "richtext",
			"id": "description",
			"default": "t:sections.collapsible-content.settings.text.default",
			"label": "t:sections.all.description.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.button.header.content"
		},
		{
			"type": "text",
			"id": "button_label",
			"default": "t:sections.collapsible-content.settings.button_label.default",
			"label": "t:sections.all.button.label.label",
			"info": "t:sections.all.button.label.info"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "t:sections.all.button.link.label"
		},
		{
			"type": "select",
			"id": "button_style",
			"options": [
				{ "value": "primary", "label": "t:sections.all.button.style.options__1.label" },
				{ "value": "secondary", "label": "t:sections.all.button.style.options__2.label" },
				{ "value": "tertiary", "label": "t:sections.all.button.style.options__3.label" }
			],
			"default": "primary",
			"label": "t:sections.all.button.style.options__1.label"
		},
		{
			"type": "checkbox",
			"id": "button_arrow",
			"default": false,
			"label": "t:sections.all.button.arrow.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.section-margin.header.content"
		},
		{
			"type": "select",
			"id": "margin_top",
			"options": [
				{ "value": "no-indent", "label": "t:sections.all.section-margin.options__1.label" },
				{ "value": "xs", "label": "t:sections.all.section-margin.options__2.label" },
				{ "value": "s", "label": "t:sections.all.section-margin.options__3.label" },
				{ "value": "m", "label": "t:sections.all.section-margin.options__4.label" },
				{ "value": "l", "label": "t:sections.all.section-margin.options__5.label" }
			],
			"default": "no-indent",
			"label": "t:sections.all.section-margin.margin_top.label"
		},
		{
			"type": "select",
			"id": "margin_bottom",
			"options": [
				{ "value": "no-indent", "label": "t:sections.all.section-margin.options__1.label" },
				{ "value": "xs", "label": "t:sections.all.section-margin.options__2.label" },
				{ "value": "s", "label": "t:sections.all.section-margin.options__3.label" },
				{ "value": "m", "label": "t:sections.all.section-margin.options__4.label" },
				{ "value": "l", "label": "t:sections.all.section-margin.options__5.label" }
