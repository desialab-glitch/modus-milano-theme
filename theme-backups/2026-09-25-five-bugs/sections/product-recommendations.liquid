{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-card-slider.js' | asset_url }}" defer="defer">
<link rel="stylesheet" href="{{ 'section-products-grid.css' | asset_url }}" media="all"></script>
<script src="{{ 'product-slider.js' | asset_url }}" defer="defer"></script>

{%- style -%}
	{% render 'section-margin' %}
	#shopify-section-{{ section.id }} {
		--perRow: {{ section.settings.per_row }};
	}
	@media screen and (min-width: 576px) {
		#shopify-section-{{ section.id }} .collection-product-list {
			grid-template-columns: repeat(var(--perRow), 1fr) !important;
		}
	}
	@media screen and (min-width: 990px) {
		#shopify-section-{{ section.id }} .section-header__title__block {
			flex-direction: row !important;
			align-items: center !important;
			justify-content: space-between !important;
		}
	}
{%- endstyle -%}

{% assign section_id = 'shopify-section-' | append: section.id %}

{% liquid
	if section.settings.show_arrows
		assign show_arrows = true
	else
		assign show_arrows = false
	endif

	assign carousel_mobile_count = 1
	if section.settings.show_two_cards
		assign carousel_mobile_count = 2
	endif
%}

{%- comment -%}
  Use intent=complementary so each product shows its own manually curated
  pairings set via the Shopify Search & Discovery app metafields,
  rather than the algorithmic "related" suggestions.
{%- endcomment -%}
<product-recommendations
	class="product-recommendations"
	data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=complementary"
>
	{% render 'section-header', show_arrows: show_arrows %}

	{% if recommendations.performed and recommendations.products_count > 0 %}

		{% if section.settings.mobile_carousel %}

			{%- comment -%}
			  Carousel on mobile: reuses the theme's existing products-slider
			  markup/data-attributes so product-slider.js (already loaded site-wide)
			  picks it up automatically. Swiper scales slidesPerView up via its
			  breakpoints, so desktop still shows every product in a static row.
			{%- endcomment -%}
			<div
				class="products-slider"
				data-id="{{ section_id }}"
				data-speed="{{ section.settings.slideshow_speed }}"
				data-delay="{{ section.settings.slideshow_delay }}"
				data-autoplay="{{ section.settings.autoplay }}"
				data-stop-autoplay="{{ section.settings.stop_autoplay }}"
				data-show-arrows="{{ section.settings.show_arrows }}"
				data-per-row="{{ section.settings.per_row }}"
				data-mobile="{{ carousel_mobile_count }}"
				style="--slider-per-row: {{ section.settings.per_row }}"
			>
				<div class="products-slider__container container">
					<div class="products-slider__wrapper">
						<div class="products-slider__swiper swiper mySwiper">
							<div class="products-slider__swiper-wrapper swiper-wrapper">
								{%- for product in recommendations.products -%}
									{%- assign image_index = forloop.index | modulo: 6 | plus: 1 -%}
									<div class="products-slider__slide swiper-slide">
										{% render 'product-card',
											product_card_product: product,
											media_size: section.settings.image_ratio,
											media_fit: section.settings.image_fit,
											show_vendor: section.settings.show_vendor,
											show_desc: true,
											show_sku: section.settings.show_sku,
											section_id: section.id,
											image_index: image_index,
											render_settings: section.settings
										%}
									</div>
								{%- endfor -%}
							</div>
						</div>
					</div>
					{% if section.settings.show_arrows %}
						<div class="swiper-pagination products-slider-pagination swiper-pagination-default"></div>
					{% endif %}
				</div>
			</div>

		{% else %}

			<div class="container">
			<ul class="collection-product-list{% if section.settings.show_two_cards %} collection-product-list--two{% endif %}" role="list">
				{%- for product in recommendations.products -%}
					{%- assign image_index = forloop.index | modulo: 6 | plus: 1 -%}
					<li class="collection-product-card{% if settings.on_hover == 'hover' %} quickview--hover{% endif %}">
						{% render 'product-card',
							product_card_product: product,
							media_size: section.settings.image_ratio,
							media_fit: section.settings.image_fit,
							show_vendor: section.settings.show_vendor,
							show_desc: true,
							show_sku: section.settings.show_sku,
							section_id: section.id,
							image_index: image_index,
							render_settings: section.settings
						%}
					</li>
				{%- endfor -%}
			</ul>
			</div>

		{% endif %}

	{% else %}

		{%- comment -%}
		  Fallback: no complementary products configured yet for this product.
		  Show nothing rather than falling back to same-category products.
		{%- endcomment -%}

	{% endif %}

	{% if section.settings.section_header_type == 'type1' and section.settings.button_label != blank %}
		<div class="section-header_btn container">
			{% if section.settings.button_label != blank %}
				{% render 'button', layout: section %}
			{% endif %}
		</div>
	{% endif %}
</product-recommendations>

{% javascript %}
	class ProductRecommendations extends HTMLElement {
		connectedCallback() {
			if (this.recommendationsLoaded) return;
			this.recommendationsLoaded = true;

			const load = () => {
				if (this.recommendationsRequested) return;
				this.recommendationsRequested = true;

				fetch(this.dataset.url)
					.then((response) => response.text())
					.then((text) => {
						const html = document.createElement('div');
						html.innerHTML = text;
						const recommendations = html.querySelector(
							'product-recommendations'
						);
						if (recommendations && recommendations.innerHTML.trim().length) {
							this.innerHTML = recommendations.innerHTML;
						}

						if (
							this.querySelector('.swiper-container') &&
							typeof Swiper !== 'undefined'
						) {
							try {
								new Swiper('.swiper-container', {
									slidesPerView: 1,
									spaceBetween: 0,
									navigation: {
										nextEl: '.product-button-group .swiper-button-next-1',
										prevEl: '.product-button-group .swiper-button-prev-1',
									},
								});
							} catch (e) {
								console.error(e);
							}
						}

						if (typeof buttonHoverEffects === 'function') {
							buttonHoverEffects();
						}
					})
					.catch((e) => {
						console.error(e);
					});
			};

			if ('IntersectionObserver' in window) {
				const observer = new IntersectionObserver(
					(entries) => {
						if (!entries[0].isIntersecting) return;
						observer.unobserve(this);
						load();
					},
					{ rootMargin: '0px 0px 200px 0px' }
				);
				observer.observe(this);

				setTimeout(load, 1500);
			} else {
				load();
			}
		}
	}

	customElements.define('product-recommendations', ProductRecommendations);
{% endjavascript %}

{% schema %}
{
	"name": "t:sections.product-recommendations.name",
	"tag": "section",
	"class": "spaced-section section-product-recommendations no-js-hidden",
	"settings": [
