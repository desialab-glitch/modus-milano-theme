{% doc %}
  @prompt
    Infinite auto-scrolling gallery carousel (like a brand ticker but with full photos instead of logos). Up to 8 images, editable spacing, ticker speed, colors and margins.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gallery-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
    position: relative;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    background-color: {{ block.settings.background_color }};
    padding: 10px 0;
  }

  .ai-gallery-carousel-{{ ai_gen_id }}.gc-ticker {
    width: auto;
    max-width: none;
  }


  .ai-gallery-carousel-{{ ai_gen_id }} .gc-wrapper {
    display: flex;
    width: max-content;
  }

  .ai-gallery-carousel-{{ ai_gen_id }}.gc-ticker .gc-wrapper {
    animation: gc-scroll-{{ ai_gen_id }} {{ block.settings.ticker_speed }}s linear infinite;
  }

  .ai-gallery-carousel-{{ ai_gen_id }}:not(.gc-ticker) .gc-wrapper {
    justify-content: center;
    flex-wrap: wrap;
    width: 100%;
  }

  .ai-gallery-carousel-{{ ai_gen_id }} .gc-set {
    display: flex;
    align-items: center;
    gap: {{ block.settings.item_gap }}px;
    padding-right: {{ block.settings.item_gap }}px;
    flex-shrink: 0;
  }

  .ai-gallery-carousel-{{ ai_gen_id }}:not(.gc-ticker) .gc-set {
    flex-wrap: wrap;
    justify-content: center;
    padding-right: 0;
  }

  .ai-gallery-carousel-{{ ai_gen_id }}:not(.gc-ticker) .gc-set[aria-hidden="true"] {
    display: none;
  }

  .ai-gallery-carousel-{{ ai_gen_id }} .gc-item {
    display: block;
    flex-shrink: 0;
    height: {{ block.settings.item_height }}px;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-gallery-carousel-{{ ai_gen_id }} .gc-item img {
    display: block;
    height: 100%;
    width: auto;
    max-width: none;
    object-fit: cover;
    border-radius: {{ block.settings.border_radius }}px;
  }

  @keyframes gc-scroll-{{ ai_gen_id }} {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
{% endstyle %}

<div
  class="ai-gallery-carousel-{{ ai_gen_id }}{% if block.settings.ticker_enabled %} gc-ticker{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="gc-wrapper">
    {% assign sets = '1,2' | split: ',' %}
    {% for set in sets %}
      <div class="gc-set" aria-hidden="{% if forloop.index == 2 %}true{% else %}false{% endif %}">
        {% for i in (1..8) %}
          {% assign img_key = 'image_' | append: i %}
          {% assign link_key = 'link_' | append: i %}
          {% assign gc_image = block.settings[img_key] %}
          {% assign gc_link = block.settings[link_key] %}
          {% if gc_image != blank %}
            {% if gc_link != blank %}
              <a href="{{ gc_link }}" class="gc-item">
            {% else %}
              <div class="gc-item">
            {% endif %}
              {{
                gc_image
                | image_url: width: 800
                | image_tag: loading: 'lazy', class: 'gc-image'
              }}
            {% if gc_link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Gallery carousel",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Images (in order)" },
    { "type": "image_picker", "id": "image_1", "label": "Image 1" },
    { "type": "url", "id": "link_1", "label": "Link 1 (optional)" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "url", "id": "link_2", "label": "Link 2 (optional)" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3" },
    { "type": "url", "id": "link_3", "label": "Link 3 (optional)" },
    { "type": "image_picker", "id": "image_4", "label": "Image 4" },
    { "type": "url", "id": "link_4", "label": "Link 4 (optional)" },
    { "type": "image_picker", "id": "image_5", "label": "Image 5" },
    { "type": "url", "id": "link_5", "label": "Link 5 (optional)" },
    { "type": "image_picker", "id": "image_6", "label": "Image 6" },
    { "type": "url", "id": "link_6", "label": "Link 6 (optional)" },
    { "type": "image_picker", "id": "image_7", "label": "Image 7" },
    { "type": "url", "id": "link_7", "label": "Link 7 (optional)" },
    { "type": "image_picker", "id": "image_8", "label": "Image 8" },
    { "type": "url", "id": "link_8", "label": "Link 8 (optional)" },
    { "type": "header", "content": "Ticker" },
    {
      "type": "checkbox",
      "id": "ticker_enabled",
      "label": "Auto-scroll in loop",
      "default": true,
      "info": "Off = images centered, static, no repeat."
    },
    {
      "type": "range",
      "id": "ticker_speed",
      "label": "Ticker speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 25,
      "info": "Higher = slower scroll."
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "item_height",
      "label": "Image height",
      "min": 80,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Spacing between images",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    { "type": "header", "content": "Section spacing" },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top margin",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    { "type": "header", "content": "Colors" },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background / edge fade color",
      "default": "#faf8f5"
    }
  ],
  "presets": [
    { "name": "Gallery carousel" }
  ]
}
{% endschema %}
