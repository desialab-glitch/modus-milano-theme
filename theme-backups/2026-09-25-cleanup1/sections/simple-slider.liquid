{{ 'simple-slider.css' | asset_url | stylesheet_tag }}
{%- comment -%}"Orange" colour variant = the orange colour scheme (D12, 2026-09-25): one orange look, styled once in modus-design-system.css.{%- endcomment -%}
{%- liquid
	assign section_scheme = section.settings.color_scheme
	if section.settings.color_variant == 'orange'
		assign section_scheme = 'scheme-orange-bg-01473e-cta'
	endif
-%}

<script src="{{ 'simple-slider.js' | asset_url }}" defer="defer"></script>

{% liquid
	assign autoplay = section.settings.is_autoplay
	assign stop_autoplay = section.settings.stop_autoplay
	assign slideshow_delay = section.settings.slideshow_delay
	assign slideshow_speed = section.settings.slideshow_speed

	if section.settings.show_arrows
		assign show_arrows = true
	else
		assign show_arrows = false
	endif

	if section.settings.auto_per_row
		assign effective_per_row = section.blocks.size | at_most: 3
		if effective_per_row < 1
			assign effective_per_row = 1
		endif
	else
		assign effective_per_row = section.settings.per_row
	endif
%}

{% style %}
	{% render 'section-margin' %}
	#shopify-section-{{ section.id }} {
		--perRow: {{ effective_per_row }};
	}
	/* Description -> button gap: unified to the shared eyebrow/heading/
	   description/CTA rhythm token (2026-09-06, tokenized 2026-09-07) to
	   match every other gap in this item block (image->subheading,
	   subheading->heading, heading->description) — see modus-design-
	   system.css for the .simple-slider_location rule that carries the
	   matching change and the full rationale. */
	#shopify-section-{{ section.id }} .simple-slider_content .button {
		margin-top: var(--modus-space-xs);
	}
	/* Location/subheading -> heading gap: unified to the same rhythm token
	   as heading->description. Previously 2rem, which made this one gap in
	   the item block visibly larger than the others. The image->subheading
	   gap itself is controlled in modus-design-system.css
	   (.simple-slider_location margin-top), not here — that file's
	   !important rule always won over this section's old non-!important
	   3.2rem attempt, which is why that earlier fix never visibly took
	   effect. Removed the dead rule below. */
	#shopify-section-{{ section.id }} .simple-slider_image-wrapper .simple-slider_location {
		position: static;
		transform: none;
		opacity: 1;
		margin-bottom: 0;
		width: auto;
		justify-content: flex-start;
	}
	#shopify-section-{{ section.id }} .simple-slider_content {
		margin-top: var(--modus-space-xs) !important;
	}
	#shopify-section-{{ section.id }} .simple-slider_image-wrapper {
		max-width: {{ section.settings.image_width_mobile | default: 100 }}%;
		margin-left: auto;
		margin-right: auto;
	}
	@media screen and (min-width: 750px) {
		#shopify-section-{{ section.id }} .simple-slider_image-wrapper {
			max-width: {{ section.settings.image_width_desktop | default: 100 }}%;
		}
	}
	/* This section's title-item gap is intentionally reset to 0 (guards
	   against the base theme's own flex-gap doubling with the heading's
	   own margin-bottom, if any). The accompanying "margin-bottom: .8rem"
	   that used to sit here (attempting a tighter eyebrow->heading gap than
	   the sitewide default) never actually took effect: modus-design-system
	   .css's ".section-header__title-item .section-header__title { margin:
	   0 0 var(--modus-space-xs) !important }" always wins over a
	   non-!important declaration regardless of specificity or wrapper, so
	   this section's title->description gap has always matched every other
	   section's (var(--modus-space-xs), currently 1.2rem) — removed the
	   inert line (2026-09-07) rather than leave code that implies
	   otherwise. */
	#shopify-section-{{ section.id }} .section-header__title-item {
		gap: 0;
	}
	{% if section.settings.color_variant == 'orange' %}
	/* "Orange" variant = the orange colour scheme (D12, 2026-09-25): text,
	   eyebrows, buttons and pagination dots come from the scheme rules in
	   modus-design-system.css. This slider has no padding settings, so its
	   Margin top/bottom are its inner spacing; the wrapper is painted the
	   same (single) orange so the block stays one orange band, as before. */
	#shopify-section-{{ section.id }} {
		background-color: var(--modus-orange);
	}
	{% endif %}
{% endstyle %}

{% style %}
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .simple-slider.no-mobile-slider .swiper,
    #shopify-section-{{ section.id }} .simple-slider.no-mobile-slider .swiper-wrapper {
      display: flex !important;
      flex-direction: column !important;
      transform: none !important;
      height: auto !important;
      overflow: visible !important;
    }
    #shopify-section-{{ section.id }} .simple-slider.no-mobile-slider .swiper-slide {
      width: 100% !important;
      height: auto !important;
      margin-bottom: 2.4rem;
    }
    #shopify-section-{{ section.id }} .simple-slider.no-mobile-slider .swiper-pagination,
    #shopify-section-{{ section.id }} .simple-slider.no-mobile-slider .swiper-button-next,
    #shopify-section-{{ section.id }} .simple-slider.no-mobile-slider .swiper-button-prev {
      display: none !important;
    }
  }
{% endstyle %}
<div
	class="simple-slider{% unless section.settings.mobile_slider %} no-mobile-slider{% endunless %} color-{{ section_scheme }} background"
	data-id="shopify-section-{{ section.id }}"
	data-autoplay="{{ autoplay }}"
	data-stop-autoplay="{{ stop_autoplay }}"
	data-speed="{{ slideshow_speed }}"
	data-delay="{{ slideshow_delay }}"
	data-per-row="{{ effective_per_row }}"
>
	{% render 'section-header', show_arrows: show_arrows %}
	<div class="container">
		<div class="swiper">
			<div class="simple-slider-wrapper swiper-wrapper">
				{% liquid
					assign media_size = section.settings.image_ratio
					case media_size
						when 'landscape'
							assign image_size = '56.25%'
						when 'portrait'
							assign image_size = '130%'
						when 'square'
							assign image_size = '100%'
						else
							assign image_size = '100%'
					endcase
				%}
				{% style %}
					#shopify-section-{{ section.id }} .simple-slider_image {
						--slide-height : {{ image_size }};
					}
				{% endstyle %}
				{%- for block in section.blocks -%}
					<div class="simple-slider_item swiper-slide">
						<div class="simple-slider_image-wrapper">
							<div class="simple-slider_image">
								{%- if block.settings.video != blank -%}
									{% liquid
										assign video_height = block.settings.video.sources[0].width | divided_by: block.settings.video.aspect_ratio
									%}
									{{
										block.settings.video
										| video_tag:
											width: block.settings.video.sources[0].width,
											height: video_height,
											autoplay: true,
											loop: true,
											controls: false,
											muted: true
									}}
								{%- elsif block.settings.image != blank -%}
									{% assign image_height = block.settings.image.width
										| divided_by: block.settings.image.aspect_ratio
									%}
									{{
										block.settings.image
										| image_url: width: 3840
										| image_tag:
											loading: 'lazy',
											width: block.settings.image.width,
											height: image_height,
											sizes: '100vw',
											widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
									}}
								{%- else -%}
									{% assign image_index = forloop.index
										| modulo: 6
										| plus: 1
									%}
									{{
										'collection-'
										| append: image_index
										| placeholder_svg_tag: ' placeholder'
									}}
								{%- endif -%}
							</div>
							{%- if block.settings.subheading != blank -%}
								<div class="simple-slider_location badge">
									{{ block.settings.subheading }}
								</div>
							{%- endif -%}
						</div>
						<div class="simple-slider_content">
							<h3 class="simple-slider_heading">
								{{ block.settings.heading }}
							</h3>
							<div class="simple-slider_desc medium-font">
								{{- block.settings.description -}}
							</div>
							{% if block.settings.button_label != blank %}
								{% render 'button', layout: block %}
							{% endif %}
						</div>
					</div>
				{% endfor %}
			</div>
		</div>
		{% if show_arrows %}
			<div class="swiper-pagination swiper-pagination-default"></div>
		{% endif %}
	</div>
	{% if section.settings.section_header_type == 'type1' and section.settings.button_label != blank %}
		<div class="section-header_btn container">
			{% if section.settings.button_label != blank %}
				{% render 'button', layout: section %}
			{% endif %}
		</div>
	{% endif %}
</div>

{% schema %}{
  "name": "t:sections.simple-slider.name",
  "tag": "section",
  "class": "simple-slider-section spaced-section",
  "enabled_on": {
    "templates": [
      "*"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "color_variant",
      "label": "Color variant",
      "info": "Orange = the orange colour scheme (overrides Color scheme).",
      "options": [
        {
          "value": "basic",
          "label": "Basic (scheme colors)"
        },
        {
          "value": "orange",
          "label": "Orange"
        }
      ],
      "default": "basic"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "select",
      "id": "section_header_type",
      "label": "t:sections.all.section_header.header.content",
      "default": "type1",
      "options": [
        {
          "value": "type1",
          "label": "t:sections.all.section_header.options.options__1.label"
        },
        {
          "value": "type2",
          "label": "t:sections.all.section_header.options.options__2.label"
        }
      ]
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.simple-slider.settings.heading.default",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.all.heading.tag.label",
      "info": "t:sections.all.heading.tag.info",
      "options": [
        { "value": "h1", "label": "t:sections.all.heading.tag.options.h1.label" },
        { "value": "h2", "label": "t:sections.all.heading.tag.options.h2.label" },
        { "value": "h3", "label": "t:sections.all.heading.tag.options.h3.label" },
        { "value": "h4", "label": "t:sections.all.heading.tag.options.h4.label" },
        { "value": "h5", "label": "t:sections.all.heading.tag.options.h5.label" },
        { "value": "h6", "label": "t:sections.all.heading.tag.options.h6.label" },
        { "value": "div", "label": "t:sections.all.heading.tag.options.div.label" },
        { "value": "span", "label": "t:sections.all.heading.tag.options.span.label" },
        { "value": "p", "label": "t:sections.all.heading.tag.options.p.label" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "t:sections.simple-slider.settings.subheading.default",
      "label": "t:sections.all.subheading.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.button.header.content"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "t:sections.simple-slider.settings.button_label.default",
      "label": "t:sections.all.button.label.label",
      "info": "t:sections.all.button.label.info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.all.button.link.label"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.style.options__3.label"
        }
      ],
      "default": "primary",
      "label": "t:sections.all.button.style.options__1.label"
    },
    {
      "type": "checkbox",
      "id": "button_arrow",
      "default": false,
      "label": "t:sections.all.button.arrow.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.slider_options.header.content"
    },
    {
      "type": "checkbox",
      "id": "auto_per_row",
      "default": true,
      "label": "Auto items per row",
      "info": "Automatically sets columns to match the number of items added (max 3). Disable to set manually."
    },
    {
      "type": "range",
      "id": "per_row",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1,
      "label": "Items per row (manual override)"
    },
    {
      "type": "checkbox",
      "id": "mobile_slider",
      "default": true,
      "label": "Enable slider on mobile"
    },
    {
      "type": "checkbox",
      "id": "is_autoplay",
      "default": false,
      "label": "t:sections.all.slider_options.slider_is_autoplay.label"
    },
    {
      "type": "checkbox",
      "id": "stop_autoplay",
      "default": true,
      "label": "t:sections.all.slider_options.slider_hover_autoplay_stop.label"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "default": true,
      "label": "t:sections.all.slider_options.navigation.label"
    },
    {
      "type": "range",
      "id": "slideshow_speed",
      "min": 0,
      "max": 6,
      "step": 0.1,
      "default": 1.1,
      "unit": "s",
      "label": "t:sections.all.slider_options.speed.label"
    },
    {
      "type": "range",
      "id": "slideshow_delay",
      "min": 0,
      "max": 8,
      "step": 0.1,
      "default": 3,
      "unit": "s",
      "label": "t:sections.all.slider_options.delay.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "landscape",
          "label": "t:sections.all.image.ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.image.ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.all.image.ratio.options__3.label"
        }
      ],
      "default": "landscape",
      "label": "t:sections.all.image.size.full_label"
    },
    {
      "type": "range",
      "id": "image_width_desktop",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "label": "Image width (desktop)"
    },
    {
      "type": "range",
      "id": "image_width_mobile",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "label": "Image width (mobile)"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        { "value": "no-indent", "label": "t:sections.all.section-margin.options__1.label" },
        { "value": "xs", "label": "t:sections.all.section-margin.options__2.label" },
        { "value": "s", "label": "t:sections.all.section-margin.options__3.label" },
        { "value": "m", "label": "t:sections.all.section-margin.options__4.label" },
        { "value": "l", "label": "t:sections.all.section-margin.options__5.label" }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        { "value": "no-indent", "label": "t:sections.all.section-margin.options__1.label" },
        { "value": "xs", "label": "t:sections.all.section-margin.options__2.label" },
        { "value": "s", "label": "t:sections.all.section-margin.options__3.label" },
        { "value": "m", "label": "t:sections.all.section-margin.options__4.label" },
        { "value": "l", "label": "t:sections.all.section-margin.options__5.label" }
      ],
      "default": "xs",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.simple-slider.blocks.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.all.image.label"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.all.video.label"
        },
        {
          "type": "text",
          "id": "subheading",
          "default": "t:sections.simple-slider.blocks.settings.subheading.default",
          "label": "t:sections.all.subheading.label"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.simple-slider.blocks.settings.heading.default",
          "label": "t:sections.all.heading.label"
        },
        {
          "type": "richtext",
          "id": "description",
          "default": "t:sections.simple-slider.blocks.settings.description.default",
          "label": "t:sections.all.description.label"
        },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "default": "tertiary",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "secondary", "label": "Secondary" },
            { "value": "tertiary", "label": "Tertiary" }
          ]
        },
        { "type": "checkbox", "id": "button_arrow", "default": false, "label": "Show arrow" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.simple-slider.presets.name",
      "blocks": [
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}{% endschema %}
