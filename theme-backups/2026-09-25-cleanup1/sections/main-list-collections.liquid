{{- 'template-collection-list.css' | asset_url | stylesheet_tag -}}
{%- if section.settings.mobile_layout == 'carousel' -%}
	<script src="{{ 'collection-grid.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{% style %}
	{% render 'section-margin' %}
	#shopify-section-{{ section.id }} {
		--per-row : {{ section.settings.per_row }}
	}
	#shopify-section-{{ section.id }} .collection-list .have-overlay {
		--overlay-alpha : {{ section.settings.overlay_opacity }}%;
	}

	/* Match the eyebrow -> heading -> paragraph rhythm used elsewhere on the
	   page (e.g. the Hero Split section above): the shared section-header
	   snippet ships a tight 0.6rem flex gap sitewide, which reads as
	   noticeably tighter than the ~1.2rem gap used in the hero. Scoped to
	   this section's own id so no other section using section-header.liquid
	   elsewhere on the site is affected. Tokenized to var(--modus-space-xs)
	   (2026-09-07, was hardcoded 1.2rem). */
	#shopify-section-{{ section.id }} .section-header__title-item {
		gap: var(--modus-space-xs);
	}

	/* Mobile layout options (default = existing 1-column stacked grid, no
	   extra CSS needed for that case).
	   "2 columns per row on mobile" -- scoped override of the shared
	   template-collection-list.css base rule (which is unscoped and always
	   1fr below 576px), so only this section's instance is affected. */
	@media screen and (max-width: 575px) {
		#shopify-section-{{ section.id }} .collections-grid--mobile-2 {
			grid-template-columns: repeat(2, 1fr) !important;
		}
	}

	/* "Carousel with dots" on mobile -- two markups are rendered (the normal
	   grid <ul> and a swiper carousel), each visible only in its own
	   viewport range so the section reads as one coherent layout: grid at
	   tablet/desktop widths, swipeable single-column carousel below 576px,
	   same swiper + dot-pagination pattern used by sections/collection-carousel.liquid
	   (collection-grid.js + .swiper-pagination-default, styled site-wide in
	   modus-iwt-spacing-fix.css). */
	#shopify-section-{{ section.id }} .collections-grid--mobile-carousel {
		display: none;
	}
	@media screen and (max-width: 575px) {
		#shopify-section-{{ section.id }} .collections-grid--desktop-only {
			display: none;
		}
		#shopify-section-{{ section.id }} .collections-grid--mobile-carousel {
			display: block;
		}
	}
	#shopify-section-{{ section.id }} .collections-grid--mobile-carousel .swiper-slide {
		width: 100%;
		height: auto;
	}
	#shopify-section-{{ section.id }} .collections-grid--mobile-carousel .swiper-pagination.swiper-pagination-default {
		margin-top: 1.6rem;
	}
{% endstyle %}

<div class="collection-list">
	{% render 'section-header', section_button_label: false %}
	<div class="container">
		{% comment %}{% if section.settings.title != blank %}
			<div class="page-header">
				<div class="page-header__inner">
					<h1 class="main-page-title page-title  h2">
						{{ section.settings.title | escape }}
					</h1>
				</div>
			</div>
		{% endif %}{% endcomment %}

		{%- liquid
			assign collection_button_label = 'collection.collection_button_label' | t
			case section.settings.sort
				when 'products_high', 'products_low'
					assign collections_sorted = collections | sort: 'all_products_count'
				when 'date', 'date_reversed'
					assign collections_sorted = collections | sort: 'published_at'
				else
					assign collections_sorted = collections
			endcase

			if section.settings.sort == 'products_high' or section.settings.sort == 'date_reversed' or section.settings.sort == 'alphabetical_reversed'
				assign collections_sorted = collections_sorted | reverse
			endif
		-%}
		{%- paginate collections by section.settings.collection_per_page -%}
			<ul
				class="collection-product-list collections-grid{% if section.settings.mobile_layout == '2' %} collections-grid--mobile-2{% endif %}{% if section.settings.mobile_layout == 'carousel' %} collections-grid--desktop-only{% endif %}"
				role="list"
			>
				{%- assign offset = paginate.current_offset -%}
				{%- for collection in collections_sorted limit: paginate.page_size offset: offset -%}
					<li class="collections-grid__card">
						{% render 'collection-card',
							block_collection: collection,
							media_size: section.settings.image_ratio,
							url: collection.url,
							collection_title: collection.title,
							collection_desc: collection.description,
							collection_image: collection.image,
							show_collection_desc: section.settings.show_collection_desc,
							card_type: section.settings.card_type,
							show_collection_button: section.settings.show_collection_button,
							btn_label: collection_button_label,
							btn_link: collection.url,
							enable_arrow: section.settings.button_arrow,
							text_align: section.settings.text_horizontal,
							heading_size: section.settings.heading_size,
							desc_size: section.settings.desc_size,
							hover_effect: section.settings.hover_effect,
							text_animation: section.settings.text_animation,
						%}
					</li>
				{%- endfor -%}
			</ul>

			{%- if section.settings.mobile_layout == 'carousel' -%}
				<div
					class="collection-grid collections-grid--mobile-carousel"
					data-id="shopify-section-{{ section.id }}"
					data-autoplay="false"
					data-speed="0.6"
					data-delay="3"
					data-per_row="1"
				>
					<div class="swiper">
						<div class="swiper-wrapper">
							{%- for collection in collections_sorted limit: paginate.page_size offset: offset -%}
								<div class="swiper-slide">
									{% render 'collection-card',
										block_collection: collection,
										media_size: section.settings.image_ratio,
										url: collection.url,
										collection_title: collection.title,
										collection_desc: collection.description,
										collection_image: collection.image,
										show_collection_desc: section.settings.show_collection_desc,
										card_type: section.settings.card_type,
										show_collection_button: section.settings.show_collection_button,
										btn_label: collection_button_label,
										btn_link: collection.url,
										enable_arrow: section.settings.button_arrow,
										text_align: section.settings.text_horizontal,
										heading_size: section.settings.heading_size,
										desc_size: section.settings.desc_size,
										hover_effect: section.settings.hover_effect,
										text_animation: section.settings.text_animation,
									%}
								</div>
							{%- endfor -%}
						</div>
						<div class="swiper-pagination swiper-pagination-default"></div>
					</div>
				</div>
			{%- endif -%}

			{%- if paginate.pages > 1 -%}
				{% render 'pagination', paginate: paginate %}
			{%- endif -%}
		{%- endpaginate -%}
	</div>
</div>

