{%- style -%}
  {% render 'section-margin' %}
  {% render 'section-padding' %}

  .sdp-bridge-{{ section.id }} {
    background: #faf8f5;
  }

  .sdp-inner-{{ section.id }} {
    display: flex;
    gap: 108px;
    align-items: flex-start;
    padding-top: 72px;
    padding-bottom: 72px;
  }

  /* ── Left column ── */
  .sdp-left-{{ section.id }} {
    flex: 0 0 480px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .sdp-eyebrow-{{ section.id }} {
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 14px;
    line-height: 26px;
    color: #4d4d4d;
    /* Tokenized to var(--modus-space-xs) (2026-09-07, was hardcoded
       1.2rem) -- same value modus-design-system.css's [class*="eyebrow"]
       rule would otherwise force anyway, now sharing one source. */
    margin: 0 0 var(--modus-space-xs);
  }

  .sdp-heading-{{ section.id }} {
    font-family: 'Antonio', sans-serif;
    font-weight: 400;
    font-size: 40px;
    line-height: 48px;
    color: #c28342;
    text-transform: uppercase;
    /* Tokenized to var(--modus-space-xs) (2026-09-07, was hardcoded 1.2rem). */
    margin: 0 0 var(--modus-space-xs);
    letter-spacing: 0.5px;
  }

  .sdp-body-{{ section.id }} {
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 15px;
    line-height: 26px;
    color: #4d4d4d;
    /* Tokenized to var(--modus-space-xs) (2026-09-07, was hardcoded 1.2rem). */
    margin: 0 0 var(--modus-space-xs);
    max-width: 460px;
  }

  /* ── Right column ── */
  .sdp-right-{{ section.id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    /* Tokenized to var(--modus-space-xs) (2026-09-07, was hardcoded
       1.2rem; paragraph -> quote block gap). */
    gap: var(--modus-space-xs);
  }

  .sdp-para-{{ section.id }} {
    font-family: 'Lora', serif;
    font-size: 15px;
    line-height: 26px;
    color: #4d4d4d;
    margin: 0;
  }

  .sdp-quote-{{ section.id }} {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .sdp-quote-bar-{{ section.id }} {
    flex-shrink: 0;
    width: 3px;
    min-height: 62px;
    background: #d16a14;
    border-radius: 2px;
  }

  .sdp-quote-text-{{ section.id }} {
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 15px;
    line-height: 26px;
    color: #4d4d4d;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .sdp-inner-{{ section.id }} {
      flex-direction: column;
      gap: 40px;
      padding-top: 48px;
      padding-bottom: 48px;
    }
    .sdp-left-{{ section.id }} {
      flex: unset;
      width: 100%;
    }
    .sdp-right-{{ section.id }} {
      width: 100%;
    }
  }
{%- endstyle -%}

<div class="sdp-bridge-{{ section.id }} section-{{ section.id }}-padding">
  <div class="container">
    <div class="sdp-inner-{{ section.id }}">

      <!-- LEFT -->
      <div class="sdp-left-{{ section.id }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sdp-eyebrow-{{ section.id }}">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="sdp-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.body_left != blank -%}
          <p class="sdp-body-{{ section.id }}">{{ section.settings.body_left }}</p>
        {%- endif -%}

        {%- if section.settings.cta_label != blank -%}
          <a
            {% if section.settings.cta_link != blank %}href="{{ section.settings.cta_link }}"{% endif %}
            class="button button--primary button--cta{% if settings.button_animation %} button-animation{% endif %}"
            {% if section.settings.cta_link == blank %}aria-disabled="true"{% endif %}
          >
            {% if settings.button_animation %}
              <span class="animation-wrapper" hoverstagger="link">
                <span class="button-label animation" hoverstagger="text">
                  <span class="word" id="word1">{{ section.settings.cta_label | strip }}</span>
                </span>
                <span class="button-label is-2 animation" hoverstagger="text">
                  <span class="word" id="word2">{{ section.settings.cta_label | strip }}</span>
                </span>
              </span>
            {% else %}
              <span class="button-label">{{ section.settings.cta_label | strip }}</span>
            {% endif %}
          </a>
        {%- endif -%}
      </div>

      <!-- RIGHT -->
      <div class="sdp-right-{{ section.id }}">
        {%- if section.settings.body_right != blank -%}
          <p class="sdp-para-{{ section.id }}">{{ section.settings.body_right }}</p>
        {%- endif -%}

        {%- if section.settings.quote != blank -%}
          <div class="sdp-quote-{{ section.id }}">
            <div class="sdp-quote-bar-{{ section.id }}"></div>
            <p class="sdp-quote-text-{{ section.id }}">{{ section.settings.quote }}</p>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Storie di Pane Bridge",
  "tag": "section",
  "class": "spaced-section sdp-bridge-section",
  "enabled_on": { "templates": ["*"] },
  "settings": [
    {
      "type": "header",
      "content": "Left column"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Le nostre origini"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "DA STORIE DI PANE A MODUS"
    },
    {
      "type": "textarea",
      "id": "body_left",
      "label": "Body text",
      "default": "Ogni giorno, i prodotti cilentani raggiungono i quattro locali milanesi grazie a una logistica unica ideata da Paolo De Simone — stessi produttori, stessi impasti, stessa cucina."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "SCOPRI LA FILIERA"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "Right column"
    },
    {
      "type": "textarea",
      "id": "body_right",
      "label": "Body text",
      "default": "Dal cuore del Cilento a Milano, la storia di Paolo De Simone è un viaggio che celebra la fusione tra tradizione e innovazione. Con Storie di Pane a Vallo della Lucania ha creato un punto di riferimento dove la panificazione, la ristorazione e la sperimentazione si incontrano per dare vita a prodotti unici, radicati nel territorio."
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Blockquote",
      "default": "Da Storie di Pane a Modus, ogni passo è stato un’evoluzione naturale — un percorso che intreccia il sapere artigianale del Cilento con la vivacità di Milano."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "margin_top",
      "default": "no-indent",
      "label": "Margin top",
      "options": [
        { "value": "no-indent", "label": "None" },
        { "value": "xs", "label": "XS" },
        { "value": "s", "label": "S" },
        { "value": "m", "label": "M" },
        { "value": "l", "label": "L" }
      ]
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "default": "no-indent",
      "label": "Margin bottom",
      "options": [
        { "value": "no-indent", "label": "None" },
        { "value": "xs", "label": "XS" },
        { "value": "s", "label": "S" },
        { "value": "m", "label": "M" },
        { "value": "l", "label": "L" }
      ]
    },
    {
      "type": "select",
      "id": "padding_top",
      "default": "no-indent",
      "label": "Padding top",
      "options": [
        { "value": "no-indent", "label": "None" },
        { "value": "xs", "label": "XS" },
        { "value": "s", "label": "S" },
        { "value": "m", "label": "M" },
        { "value": "l", "label": "L" }
      ]
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "default": "no-indent",
      "label": "Padding bottom",
      "options": [
        { "value": "no-indent", "label": "None" },
        { "value": "xs", "label": "XS" },
        { "value": "s", "label": "S" },
        { "value": "m", "label": "M" },
        { "value": "l", "label": "L" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Storie di Pane Bridge",
      "settings": {
        "eyebrow": "Le nostre origini",
        "heading": "DA STORIE DI PANE A MODUS",
        "cta_label": "SCOPRI LA FILIERA"
      }
    }
  ]
}
{% endschema %}
