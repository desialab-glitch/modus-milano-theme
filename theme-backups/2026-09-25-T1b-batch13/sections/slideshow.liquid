{{ 'section-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'slideshow-mobile-btn.css' | asset_url | stylesheet_tag }}
<script src="{{ 'slideshow.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'hammer.js' | asset_url }}" defer="defer"></script>
{% style %}
	{% render 'section-margin' %}
	{% render 'section-padding' %}
	#shopify-section-{{ section.id }} .slideshow_subheading {
		font-size: 15px !important;
		opacity: 0.8 !important;
		margin-bottom: var(--modus-space-xs) !important;
	}
	#shopify-section-{{ section.id }} .slideshow-slide__title {
		margin-bottom: var(--modus-space-xs) !important;
	}
	/* Rhythm (2026-09-25): the element above the button already carries
	   var(--modus-space-xs) below it, so the button adds no padding of its
	   own (was xs + xs = 24px), and no 4rem bottom margin on mobile. The
	   last element in the text column never adds space below itself. The
	   button wrapper is only rendered when there is a button. */
	#shopify-section-{{ section.id }} .slideshow-slide__button {
		padding-top: 0 !important;
		margin-bottom: 0 !important;
	}
	#shopify-section-{{ section.id }} .slideshow-slide__text > :last-child {
		margin-bottom: 0 !important;
	}
	#shopify-section-{{ section.id }} .slideshow-slide__title,
	#shopify-section-{{ section.id }} .slideshow-slide__desc {
		max-width: none;
	}
	#shopify-section-{{ section.id }} .slideshow-slide__title,
	#shopify-section-{{ section.id }} h1.slideshow-slide__title,
	#shopify-section-{{ section.id }} h2.slideshow-slide__title,
	#shopify-section-{{ section.id }} h3.slideshow-slide__title {
		color: #faf1e4 !important;
	}
	#shopify-section-{{ section.id }} .slideshow-slide__button .button,
	#shopify-section-{{ section.id }} .slideshow-slide__button .button--primary,
	#shopify-section-{{ section.id }} .slideshow-slide__button .button--secondary,
	#shopify-section-{{ section.id }} .slideshow-slide__button .button--tertiary,
	#shopify-section-{{ section.id }} .slideshow-slide__button .button--simple {
		background: #faf1e4 !important;
		background-color: #faf1e4 !important;
		color: #D16A14 !important;
		border: none !important;
		border-color: #faf1e4 !important;
		box-shadow: none !important;
		opacity: 1 !important;
		padding: 1.2rem 2.4rem !important;
		display: inline-flex !important;
		align-items: center !important;
		gap: 0.8rem !important;
	}
	#shopify-section-{{ section.id }} .slideshow-slide__button .button:not([disabled]):not([aria-disabled=true]):hover,
	#shopify-section-{{ section.id }} .slideshow-slide__button .button--primary:not([disabled]):not([aria-disabled=true]):hover,
	#shopify-section-{{ section.id }} .slideshow-slide__button .button--secondary:not([disabled]):not([aria-disabled=true]):hover,
	#shopify-section-{{ section.id }} .slideshow-slide__button .button--tertiary:not([disabled]):not([aria-disabled=true]):hover,
	#shopify-section-{{ section.id }} .slideshow-slide__button .button--simple:not([disabled]):not([aria-disabled=true]):hover {
		background: #D16A14 !important;
		background-color: #D16A14 !important;
		color: #faf8f5 !important;
		border-color: #D16A14 !important;
	}
	#shopify-section-{{ section.id }} .slideshow-slide__button .button::before,
	#shopify-section-{{ section.id }} .slideshow-slide__button .button::after,
	#shopify-section-{{ section.id }} .slideshow-slide__button .button--tertiary::before,
	#shopify-section-{{ section.id }} .slideshow-slide__button .button--tertiary::after {
		display: none !important;
	}
	#shopify-section-{{ section.id }} .slideshow-slide__text {
		margin-left: auto !important;
		margin-right: auto !important;
	}
	#shopify-section-{{ section.id }} .slideshow-slide_full-left {
		padding-top: 6rem !important;
		padding-bottom: 6rem !important;
	}
	@media screen and (min-width: 990px) {
		#shopify-section-{{ section.id }} .slideshow-slide_full-left {
			padding-top: 8rem !important;
			padding-bottom: 8rem !important;
		}
	}
	#shopify-section-{{ section.id }} .slideshow__content-mobile {
		display: none;
	}
	@media screen and (max-width: 749px) {
		#shopify-section-{{ section.id }} .slideshow__content-desktop {
			display: none;
		}
		#shopify-section-{{ section.id }} .slideshow__content-mobile {
			display: block;
		}
	}
{% endstyle %}

{% liquid
	assign vertical_alignment = section.settings.vertical_alignment
	assign slideshow_speed = section.settings.slideshow_speed
	assign autoplay = section.settings.is_autoplay

	assign slideshow_delay = section.settings.slideshow_delay
	assign alignment = section.settings.section_alignment

	case alignment
		when 'left'
			assign section_style = 'margin : auto auto auto 0; text-align : left;'
			assign bullets = 'left : unset ; right : 0; transform: unset;'
		when 'center'
			assign section_style = ' text-align : center; justify-content: center; padding-bottom: 2rem;'
			assign section_style_sub = ' text-align : center; margin: 0 auto; justify-content: center; '
			assign bullets = 'padding-bottom: 1.2rem;'
		else
			assign section_style = 'auto 0'
	endcase
%}
<div
	class="slideshow"
	data-id="shopify-section-{{ section.id }}"
	data-autoplay="{{ autoplay }}"
	data-speed="{{ slideshow_speed }}"
	data-delay="{{ slideshow_delay }}"
	style="--bullet-duration : {{ slideshow_delay }}s"
>
	{% render 'section-header' %}
	{% for block in section.blocks %}
		{% style %}
			[data-id="{{ block.id }}"] .have-overlay {
				--overlay-alpha : {{ block.settings.overlay_opacity }}%;
			}
		{% endstyle %}
	{% endfor %}
	<div class="{%if section.settings.section_layout == "container" %} container	{% endif %} ">
		<div class="slideshow__swiper {%if section.blocks.size <= 1 %} cursor_none	{% endif %}">
			<div class="slideshow__wrapper slider slideshow__slider--bg ">
				{% for block in section.blocks %}
					{% if block.settings.slide_alignment != blank %}
						{% assign alignment = block.settings.slide_alignment %}
					{% else %}
						{% assign alignment = section.settings.section_alignment %}
					{% endif %}
					{% liquid
						assign slide_color = block.settings.color_scheme

						if block.settings.article != blank
							assign block_img = block.settings.article.image
							assign block_heading = block.settings.article.title | escape
							assign block_text = block.settings.article.excerpt | strip_html | truncatewords: 30
						else
							assign block_img = block.settings.image
							assign block_heading = block.settings.heading
							assign block_text = block.settings.text
						endif

						assign auto_mobile_crop = false
						if block.settings.mobile_image != blank
							assign hide_show_toggle = 'slideshow__content-desktop'
						elsif block_img != blank and block.settings.video == blank
							assign hide_show_toggle = 'slideshow__content-desktop'
							assign auto_mobile_crop = true
							assign mobile_crop_widths = '375,550,750,1100' | split: ','
							assign mobile_crop_ratio = 2.05
							assign src_w = block_img.width
							assign src_h = block_img.height
							assign mobile_crop_srcset = ''
							for w in mobile_crop_widths
								assign w_num = w | plus: 0
								assign ideal_h = w_num | times: mobile_crop_ratio
								assign safe_w = w_num | at_most: src_w
								assign safe_h = ideal_h | at_most: src_h | round
								assign entry = block_img | image_url: width: safe_w, height: safe_h, crop: 'center'
								assign entry = entry | append: ' ' | append: w | append: 'w'
								if forloop.first
									assign mobile_crop_srcset = entry
								else
									assign mobile_crop_srcset = mobile_crop_srcset | append: ', ' | append: entry
								endif
							endfor
							assign mobile_crop_fallback_ideal_h = 750 | times: mobile_crop_ratio
							assign mobile_crop_fallback_w = 750 | at_most: src_w
							assign mobile_crop_fallback_h = mobile_crop_fallback_ideal_h | at_most: src_h | round
						else
							assign hide_show_toggle = ''
						endif
					%}

					<div class="slideshow-swiper__slide slideshow__slider__item {% if forloop.index == 1 %}slider__item--current {% endif %}">
						<div
							class="slideshow__slider__item-inner slideshow-slide {% if section.settings.transition_effect == "slide"%} slideshow__slider__item-inner-slide{% endif %} {% if alignment == 'left' %} slideshow-slide_full-left{% endif %} {% if alignment == 'center' %} slideshow-slide_full-center{% endif %} background color-{{ slide_color }}"
							data-id="{{ block.id }}"
							data-color-scheme="color-{{ slide_color }}"
							style="align-items: {{ vertical_alignment }}"
						>
							<div
								class="slideshow-slide_full-screen_text {% if block.settings.subheading != blank %} slideshow-slide_none-sub{% endif %} slideshow__text-{{ section.settings.container_size }}"
								style="align-items: {{ vertical_alignment }}"
							>
								<div class="slideshow-slide__img have-overlay {% if block.settings.image_second != blank or block.settings.video_second != blank %}slideshow-slide__img-multi{% endif %}"{%if block.settings.use_bg_color %} style="background-color: #D16A14;"{%endif%}>
									{% unless block.settings.use_bg_color %}
									{% if block.settings.video != blank %}
										{{
											block.settings.video
											| video_tag:
												image_size: '1100x',
												autoplay: true,
												loop: true,
												controls: false,
												muted: true,
												class: '',
												style: 'object-fit: cover; object-position: center; width: 100%; height: 100%;'
										}}
									{% elsif block_img != blank %}
										{{
											block_img
											| image_url: width: 3840
											| image_tag:
												loading: 'eager',
												width: block_img.width,
												height: block_img.height,
												class: hide_show_toggle,
												sizes: '100vw',
												widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
												style: 'object-fit: cover; object-position: center; width: 100%; height: 100%;'
										}}
									{% else %}
										{% assign image_index = forloop.index
											| modulo: 6
											| plus: 1
										%}
										{{
											'collection-'
											| append: image_index
											| placeholder_svg_tag: ' placeholder'
										}}
									{% endif %}
									{% if block.settings.video_second != blank %}
										{{
											block.settings.video_second
											| video_tag:
												image_size: '1100x',
												autoplay: true,
												loop: true,
												controls: false,
												muted: true,
												class: '',
												style: 'object-fit: cover; object-position: center; width: 100%; height: 100%;'
										}}
									{% elsif block.settings.image_second != blank %}
										{{
											block.settings.image_second
											| image_url: width: 3840
											| image_tag:
												loading: 'eager',
												width: block.settings.image_second.width,
												height: block.settings.image_second.height,
												class: hide_show_toggle,
												sizes: '100vw',
												widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
												style: 'object-fit: cover; object-position: center; width: 100%; height: 100%;'
										}}
									{% endif %}
									{% if block.settings.mobile_image != blank %}
										{{
											block.settings.mobile_image
											| image_url: width: 3840
											| image_tag:
												loading: 'eager',
												width: block.settings.mobile_image.width,
												height: block.settings.mobile_image.height,
												class: 'slideshow__content-mobile',
												sizes: '100vw',
												widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
												style: 'object-fit: cover; object-position: center; width: 100%; height: 100%;'
										}}
									{% elsif auto_mobile_crop %}
										<img
											src="{{ block_img | image_url: width: mobile_crop_fallback_w, height: mobile_crop_fallback_h, crop: 'center' }}"
											srcset="{{ mobile_crop_srcset }}"
											sizes="100vw"
											alt="{{ block_img.alt | escape }}"
											loading="eager"
											width="{{ mobile_crop_fallback_w }}"
											height="{{ mobile_crop_fallback_h }}"
											class="slideshow__content-mobile"
											style="object-fit: cover; object-position: center; width: 100%; height: 100%;"
										>
									{% endif %}
									{% endunless %}
								</div>
								{%- if block.settings.article == blank -%}
								{%- endif -%}
								<div class="slideshow-slide__text" style="{{ section_style }}">
									{%- if block.settings.subheading != blank -%}
									<div class="subtitle slideshow_subheading" style="{{ section_style_sub }}">{{ block.settings.subheading }}</div>
									{%- endif -%}
									{% if block_heading != blank %}
										{% capture slideshow_slide_heading_inner %}
											{{ block_heading }}
										{% endcapture %}
										{% render 'heading-element',
											tag: block.settings.heading_tag,
											default_tag: 'h1',
											class: 'slideshow-slide__title',
											content: slideshow_slide_heading_inner
										%}
									{% endif %}
									{% if block_text != blank %}
										<div
											class="slideshow-slide__desc  {% if block.settings.article == blank %} medium-font{% endif %}  richtext__content "
										>
											{{ block_text }}
										</div>
									{% endif %}
									{%- if block.settings.article != blank or block.settings.button_label != blank -%}<div class="slideshow-slide__button">
										{% if block.settings.article != blank %}
											{% assign btn_label = 'sections.featured_blog.read_more'
												| t
											%}
											{% render 'button',
												btn_label: btn_label,
												btn_style: block.settings.button_style,
												btn_link: block.settings.article.url,
												btn_animation: settings.button_animation
											%}
										{% else %}
											{% render 'button', layout: block, new_tab: true %}
										{%- endif -%}
									</div>{%- endif -%}
								</div>
								{%- if block.settings.subheading != blank -%}
									<div></div>
								{%- endif -%}
							</div>
						</div>
					</div>
				{% endfor %}
			</div>
			<div class="slideshow-slider__buttons button-next">
				<div class="slideshow-button-prev  focus-inset" data-type="prev"></div>
				<div class="slideshow-button-next focus-inset" data-type="next"></div>
			</div>
			{%- if section.blocks.size > 1 -%}
				<div class="slideshow__cursor color-inverse" id="cursor-el1">
					<span id="cursor-icon1"> {% render 'icon-arrow' %}</span>
				</div>
			{% endif %}
			{%- if section.blocks.size > 1 -%}
				{% if section.settings.show_pagination %}
					<ol
						id="bullets-show"
						class="bullets {% if alignment == 'left' %} slideshow-slide_bullet-left{% endif %}"
						style="{{ bullets }}"
					></ol>
				{% endif %}
			{% endif %}
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.slideshow.name",
	"tag": "section",
	"class": "slideshow-section spaced-section",
	"enabled_on": {
		"templates": ["*"]
	},
	"settings": [
		{
			"type": "select",
			"id": "section_header_type",
			"label": "t:sections.all.section_header.header.content",
			"default": "type1",
			"options": [
				{
					"value": "type1",
					"label": "t:sections.all.section_header.options.options__1.label"
				},
				{
					"value": "type2",
					"label": "t:sections.all.section_header.options.options__2.label"
				}
			]
		},
		{
			"type": "checkbox",
			"id": "enable_border_top",
			"default": false,
			"label": "t:sections.all.section_header.border"
		},
		{
			"type": "text",
			"id": "subheading",
			"label": "t:sections.all.subheading.label"
		},
		{
			"type": "inline_richtext",
			"id": "heading",
			"label": "t:sections.all.heading.label"
		},
		{
			"type": "select",
			"id": "heading_tag",
			"label": "t:sections.all.heading.tag.label",
			"info": "t:sections.all.heading.tag.info",
			"options": [
				{ "value": "h1", "label": "t:sections.all.heading.tag.options.h1.label" },
				{ "value": "h2", "label": "t:sections.all.heading.tag.options.h2.label" },
				{ "value": "h3", "label": "t:sections.all.heading.tag.options.h3.label" },
				{ "value": "h4", "label": "t:sections.all.heading.tag.options.h4.label" },
				{ "value": "h5", "label": "t:sections.all.heading.tag.options.h5.label" },
				{ "value": "h6", "label": "t:sections.all.heading.tag.options.h6.label" },
				{ "value": "div", "label": "t:sections.all.heading.tag.options.div.label" },
				{ "value": "span", "label": "t:sections.all.heading.tag.options.span.label" },
				{ "value": "p", "label": "t:sections.all.heading.tag.options.p.label" }
			],
			"default": "h2"
		},
		{
			"type": "richtext",
			"id": "description",
			"label": "t:sections.all.description.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.button.header.content"
		},
		{
			"type": "text",
			"id": "button_label",
			"label": "t:sections.all.button.label.label",
			"info": "t:sections.all.button.label.info"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "t:sections.all.button.link.label"
		},
		{
			"type": "select",
			"id": "button_style",
			"options": [
				{
					"value": "primary",
					"label": "t:sections.all.button.style.options__1.label"
				},
				{
					"value": "secondary",
					"label": "t:sections.all.button.style.options__2.label"
				},
				{
					"value": "tertiary",
					"label": "t:sections.all.button.style.options__3.label"
				}
			],
			"default": "primary",
			"label": "t:sections.all.button.style.label"
		},
		{
			"type": "checkbox",
			"id": "button_arrow",
			"default": false,
			"label": "t:sections.all.button.arrow.label"
		},
		{
			"type": "select",
			"id": "section_layout",
			"default": "full",
			"label": "t:sections.all.section_size.full_label",
			"options": [
				{
					"value": "full",
					"label": "t:sections.all.section_size.options.options__1.label"
				},
				{
					"value": "container",
					"label": "t:sections.all.section_size.options.options__2.label"
				}
			]
		},
		{
			"type": "select",
			"id": "section_alignment",
			"default": "left",
			"label": "t:sections.all.text.text__alignment.horizontal.label_full",
			"options": [
				{
					"value": "left",
					"label": "t:sections.all.text.text__alignment.horizontal.options__1.label"
				},
				{
					"value": "center",
					"label": "t:sections.all.text.text__alignment.horizontal.options__2.label"
				}
			]
		},
		{
			"type": "select",
			"id": "vertical_alignment",
			"options": [
				{
					"value": "flex-start",
					"label": "t:sections.all.text.text__alignment.vertical.options__1.label"
				},
				{
					"value": "center",
					"label": "t:sections.all.text.text__alignment.vertical.options__2.label"
				},
				{
					"value": "flex-end",
					"label": "t:sections.all.text.text__alignment.vertical.options__3.label"
				}
			],
			"default": "center",
			"label": "t:sections.all.text.text__alignment.vertical.label_full"
		},
		{
			"type": "select",
			"id": "container_size",
			"options": [
				{
					"value": "small",
					"label": "t:sections.rich-text.blocks.text.settings.container_size.options.option__1"
				},
				{
					"value": "medium",
					"label": "t:sections.rich-text.blocks.text.settings.container_size.options.option__2"
				},
				{
					"value": "large",
					"label": "t:sections.rich-text.blocks.text.settings.container_size.options.option__3"
				}
			],
			"default": "small",
			"label": "t:sections.rich-text.blocks.text.settings.container_size.header"
		},
		{
			"type": "header",
			"content": "t:sections.all.slider_options.header.content"
		},
		{
			"type": "select",
			"id": "transition_effect",
			"options": [
				{
					"value": "slide",
					"label": "t:sections.slideshow.settings.transition_effect.options__1.label"
				},
				{
					"value": "stretch",
					"label": "t:sections.slideshow.settings.transition_effect.options__2.label"
				}
			],
			"default": "stretch",
			"label": "t:sections.slideshow.settings.transition_effect.label"
		},
		{
			"type": "checkbox",
			"id": "is_autoplay",
			"default": false,
			"label": "t:sections.all.slider_options.slider_is_autoplay.label"
		},
		{
			"type": "checkbox",
			"id": "show_pagination",
			"default": true,
			"label": "t:sections.all.slider_options.pagination.label"
		},
		{
			"type": "range",
			"id": "slideshow_speed",
			"min": 0,
			"max": 6,
			"step": 0.1,
			"default": 1.1,
			"unit": "s",
			"label": "t:sections.all.slider_options.speed.label"
		},
		{
			"type": "range",
			"id": "slideshow_delay",
			"min": 0,
			"max": 8,
			"step": 0.1,
			"default": 3,
			"unit": "s",
			"label": "t:sections.all.slider_options.delay.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.section-margin.header.content"
		},
		{
			"type": "select",
			"id": "margin_top",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
