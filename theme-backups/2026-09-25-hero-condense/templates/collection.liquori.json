      "p2": {"type": "column", "settings": {"image": "shopify://shop_images/626654772_18392907109194972_2824787928581884684_n_840d0147-9e59-4215-8146-82c709bc0ebf.jpg", "image_ratio": "portrait", "overlay_opacity": 0, "subheading": "Il liquore di fichi", "heading": "IL PANE DEI POVERI IN BOTTIGLIA", "heading_size": "h3", "heading_tag": "h3", "text": "<p>È l'omaggio di Theodora al fico bianco del Cilento, varietà Dottato, che un tempo chiamavano il pane dei poveri. Un liquore da sorseggiare con calma e in compagnia, magari accanto a un formaggio stagionato o ai biscotti al miele.</p>", "text_2": "", "button_label": "", "button_link": "", "button_style": "tertiary", "button_label_2": "", "button_link_2": "", "button_style_2": "secondary", "column_start": 2, "column_end": 3, "row_start": "unset", "row_end": "unset"}},
